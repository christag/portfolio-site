# Cloudflare Pages Headers Configuration

# Static assets (shorter caching to prevent corruption issues)
/_astro/*
  Cache-Control: public, max-age=86400, must-revalidate
  X-Content-Type-Options: nosniff
  Vary: Accept-Encoding

# Cache HTML files for 1 hour with revalidation
/*.html
  Cache-Control: public, max-age=3600, must-revalidate

# Cache root and pages for 1 hour
/
  Cache-Control: public, max-age=3600, must-revalidate

/portfolio
  Cache-Control: public, max-age=600, stale-while-revalidate=300
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

/services
  Cache-Control: public, max-age=600, stale-while-revalidate=300
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

/i-am
  Cache-Control: public, max-age=1200, stale-while-revalidate=600
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# Service detail pages (longer caching)
/services/*
  Cache-Control: public, max-age=1800, stale-while-revalidate=900
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# CSS and JS files (shorter caching to prevent corruption)
/*.css
  Cache-Control: public, max-age=86400, must-revalidate
  X-Content-Type-Options: nosniff

/*.js
  Cache-Control: public, max-age=86400, must-revalidate
  X-Content-Type-Options: nosniff

# Fonts (long-term caching)
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/*.woff
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/*.ttf
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Manifest and service worker files
/manifest.json
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff

/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff

# Sitemap and robots
/sitemap*.xml
  Cache-Control: public, max-age=3600
  X-Content-Type-Options: nosniff

/robots.txt
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff

# Security headers for all content
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# API routes (if any)
/api/*
  Cache-Control: no-cache, no-store, must-revalidate 