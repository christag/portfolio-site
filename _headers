# Cache-Control Headers for Performance Optimization

# Static assets (long-term caching)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Images and media (medium-term caching)
/assets/*
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff

/*.png
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff

/*.jpg
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff

/*.jpeg
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff

/*.webp
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff

/*.avif
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff

/*.svg
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff

/*.ico
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff

# HTML pages (short-term caching with revalidation)
/*.html
  Cache-Control: public, max-age=300, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# Main pages (optimized for frequent updates)
/
  Cache-Control: public, max-age=300, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

/portfolio
  Cache-Control: public, max-age=600, stale-while-revalidate=300
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

/services
  Cache-Control: public, max-age=600, stale-while-revalidate=300
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

/i-am
  Cache-Control: public, max-age=1200, stale-while-revalidate=600
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# Service detail pages (longer caching)
/services/*
  Cache-Control: public, max-age=1800, stale-while-revalidate=900
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# CSS and JS files (long-term caching)
/*.css
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/*.js
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Fonts (long-term caching)
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/*.woff
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/*.ttf
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Manifest and service worker files
/manifest.json
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff

/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff

# Sitemap and robots
/sitemap*.xml
  Cache-Control: public, max-age=3600
  X-Content-Type-Options: nosniff

/robots.txt
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff

# Security headers for all content
/*
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# API proxy headers (if using Cloudflare Workers for API caching)
/api/*
  Cache-Control: public, max-age=300, stale-while-revalidate=600
  X-Content-Type-Options: nosniff 