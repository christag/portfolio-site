# Cache Control Headers for Cloudflare Pages Edge Optimization

# Static assets - Long term caching with immutable flag
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
  Vary: Accept-Encoding

# Images - Medium term caching with stale-while-revalidate
/*.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=43200
  Vary: Accept-Encoding

/*.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=43200
  Vary: Accept-Encoding

/*.jpeg
  Cache-Control: public, max-age=86400, stale-while-revalidate=43200
  Vary: Accept-Encoding

/*.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=43200
  Vary: Accept-Encoding

/*.avif
  Cache-Control: public, max-age=86400, stale-while-revalidate=43200
  Vary: Accept-Encoding

/*.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=43200
  Vary: Accept-Encoding

# Fonts - Long term caching
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
  Vary: Accept-Encoding

/*.woff
  Cache-Control: public, max-age=31536000, immutable
  Vary: Accept-Encoding

# HTML pages - Short term caching with revalidation
/*.html
  Cache-Control: public, max-age=300, stale-while-revalidate=600
  Vary: Accept-Encoding

# Root page
/
  Cache-Control: public, max-age=300, stale-while-revalidate=600
  Vary: Accept-Encoding

# Portfolio page - Medium caching due to dynamic content
/portfolio
  Cache-Control: public, max-age=600, stale-while-revalidate=300
  Vary: Accept-Encoding

# Services page - Longer caching
/services
  Cache-Control: public, max-age=1800, stale-while-revalidate=900
  Vary: Accept-Encoding

# Manifest and service worker - Short term caching
/manifest.json
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json

/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/javascript

# Security headers for all routes
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https:; 