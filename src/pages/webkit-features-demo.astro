---
import Layout from '../layouts/Layout.astro';
import ShareButton from '../components/ShareButton.astro';
---

<Layout
  title="WebKit Features Demo - Christopher Tagliaferro"
  description="Demonstration of modern WebKit PWA features including Web Share API Level 2+ and View Transitions API"
>
  <div class="container mx-auto max-w-4xl">
    <!-- Hero Section -->
    <section class="text-center mb-16">
      <h1
        class="text-4xl lg:text-5xl font-bold mb-6 bg-gradient-to-r from-accent to-primary bg-clip-text text-transparent"
      >
        WebKit PWA Features Demo
      </h1>
      <p class="text-xl text-text-secondary mb-8 max-w-2xl mx-auto">
        Experience the latest WebKit and PWA capabilities including Web Share
        API Level 2+, View Transitions, and enhanced manifest features for
        optimal Safari and iOS support.
      </p>
    </section>

    <!-- Feature Grid -->
    <div class="grid md:grid-cols-2 gap-8 mb-16">
      <!-- Web Share API Demo -->
      <div class="glass-card p-8 rounded-2xl">
        <div class="flex items-center mb-6">
          <div
            class="w-12 h-12 bg-accent/10 rounded-lg flex items-center justify-center mr-4"
          >
            <svg
              class="w-6 h-6 text-accent"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.367 2.684 3 3 0 00-5.367-2.684z"
              ></path>
            </svg>
          </div>
          <h2 class="text-2xl font-bold">Web Share API Level 2+</h2>
        </div>

        <p class="text-text-secondary mb-6">
          Native sharing with graceful fallbacks. Supports files, URLs, and text
          with feature detection.
        </p>

        <div class="space-y-4">
          <ShareButton
            title="WebKit Features Demo"
            text="Check out these amazing WebKit PWA features!"
            variant="primary"
            label="Share This Page"
          />

          <ShareButton
            title="Christopher Tagliaferro - Technology Consultant"
            text="Expert technology consulting services"
            url="/"
            variant="secondary"
            label="Share Homepage"
          />

          <button
            id="share-file-demo"
            class="inline-flex items-center gap-2 px-4 py-2 bg-surface-secondary text-text-primary rounded-lg hover:bg-surface-tertiary transition-colors"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"
              ></path>
            </svg>
            Share File (Level 2+)
          </button>
        </div>

        <div class="mt-6 p-4 bg-surface-tertiary/50 rounded-lg">
          <h4 class="font-semibold mb-2">Browser Support:</h4>
          <ul class="text-sm text-text-secondary space-y-1">
            <li>✅ iOS Safari 14+ (URL/Text sharing)</li>
            <li>✅ Android Chrome 75+ (Full Level 2+ support)</li>
            <li>✅ Desktop Chrome/Edge (Full support)</li>
            <li>⚠️ Fallback: Copy to clipboard + modal</li>
          </ul>
        </div>
      </div>

      <!-- View Transitions Demo -->
      <div class="glass-card p-8 rounded-2xl">
        <div class="flex items-center mb-6">
          <div
            class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mr-4"
          >
            <svg
              class="w-6 h-6 text-primary"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h2 class="text-2xl font-bold">View Transitions API</h2>
        </div>

        <p class="text-text-secondary mb-6">
          Smooth page transitions with accessibility support and fallbacks for
          unsupported browsers.
        </p>

        <div class="space-y-4">
          <a
            href="/"
            class="inline-flex items-center gap-2 px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary/90 transition-colors"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
              ></path>
            </svg>
            Go to Homepage
          </a>

          <a
            href="/services"
            class="inline-flex items-center gap-2 px-4 py-2 bg-surface-secondary text-text-primary rounded-lg hover:bg-surface-tertiary transition-colors"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2-2v2m8 0V6a2 2 0 012 2v6a2 2 0 01-2 2H8a2 2 0 01-2-2V8a2 2 0 012-2V6"
              ></path>
            </svg>
            View Services
          </a>

          <button
            id="element-transition-demo"
            class="inline-flex items-center gap-2 px-4 py-2 bg-accent text-white rounded-lg hover:bg-accent/90 transition-colors"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
              ></path>
            </svg>
            Element Transition Demo
          </button>
        </div>

        <div class="mt-6 p-4 bg-surface-tertiary/50 rounded-lg">
          <h4 class="font-semibold mb-2">Browser Support:</h4>
          <ul class="text-sm text-text-secondary space-y-1">
            <li>✅ Chrome 111+ (Full support)</li>
            <li>✅ Edge 111+ (Full support)</li>
            <li>⚠️ Safari: Fallback CSS transitions</li>
            <li>⚠️ Firefox: Fallback CSS transitions</li>
            <li>♿ Respects prefers-reduced-motion</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- PWA Features Section -->
    <section class="glass-card p-8 rounded-2xl mb-16">
      <h2 class="text-3xl font-bold mb-6 text-center">Enhanced PWA Features</h2>

      <div class="grid md:grid-cols-3 gap-6">
        <div class="text-center">
          <div
            class="w-16 h-16 bg-accent/10 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <svg
              class="w-8 h-8 text-accent"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">Installable PWA</h3>
          <p class="text-text-secondary text-sm">
            Optimized manifest with proper favicon handling for iOS home screen
          </p>
        </div>

        <div class="text-center">
          <div
            class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <svg
              class="w-8 h-8 text-primary"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">Offline Support</h3>
          <p class="text-text-secondary text-sm">
            Service worker with intelligent caching strategies
          </p>
        </div>

        <div class="text-center">
          <div
            class="w-16 h-16 bg-secondary/10 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <svg
              class="w-8 h-8 text-secondary"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 17h5l-5 5v-5zM4 19h5l-5-5v5zM12 3l7 7-7 7-7-7 7-7z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">WebKit Optimized</h3>
          <p class="text-text-secondary text-sm">
            Special attention to Safari and iOS compatibility
          </p>
        </div>
      </div>
    </section>

    <!-- Debug Panel -->
    <section class="glass-card p-8 rounded-2xl mb-16">
      <h2 class="text-3xl font-bold mb-6">Debug Information</h2>
      <div id="debug-info" class="space-y-4 font-mono text-sm">
        <p>Loading debug information...</p>
      </div>
    </section>

    <!-- Technical Details -->
    <section class="glass-card p-8 rounded-2xl">
      <h2 class="text-3xl font-bold mb-6">Technical Implementation</h2>

      <div class="grid md:grid-cols-2 gap-8">
        <div>
          <h3 class="text-xl font-semibold mb-4">Web Share API Features</h3>
          <ul class="space-y-2 text-text-secondary">
            <li class="flex items-start gap-2">
              <span class="text-accent mt-1">•</span>
              Feature detection with <code
                class="bg-surface-tertiary px-2 py-1 rounded text-sm"
                >navigator.canShare</code
              >
            </li>
            <li class="flex items-start gap-2">
              <span class="text-accent mt-1">•</span>
              Level 2+ file sharing support
            </li>
            <li class="flex items-start gap-2">
              <span class="text-accent mt-1">•</span>
              Graceful fallback with clipboard API
            </li>
            <li class="flex items-start gap-2">
              <span class="text-accent mt-1">•</span>
              Toast notifications and modal UI
            </li>
            <li class="flex items-start gap-2">
              <span class="text-accent mt-1">•</span>
              Accessible with ARIA labels and keyboard support
            </li>
          </ul>
        </div>

        <div>
          <h3 class="text-xl font-semibold mb-4">View Transitions Features</h3>
          <ul class="space-y-2 text-text-secondary">
            <li class="flex items-start gap-2">
              <span class="text-primary mt-1">•</span>
              Native <code class="bg-surface-tertiary px-2 py-1 rounded text-sm"
                >document.startViewTransition</code
              >
            </li>
            <li class="flex items-start gap-2">
              <span class="text-primary mt-1">•</span>
              CSS fallback animations for unsupported browsers
            </li>
            <li class="flex items-start gap-2">
              <span class="text-primary mt-1">•</span>
              Respects <code
                class="bg-surface-tertiary px-2 py-1 rounded text-sm"
                >prefers-reduced-motion</code
              >
            </li>
            <li class="flex items-start gap-2">
              <span class="text-primary mt-1">•</span>
              Automatic link interception for SPA-like behavior
            </li>
            <li class="flex items-start gap-2">
              <span class="text-primary mt-1">•</span>
              Custom transition names for element-specific animations
            </li>
          </ul>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  import { shareFile, isWebShareSupported } from '../lib/webshare';
  import {
    transitionElement,
    isViewTransitionsSupported,
  } from '../lib/viewtransitions';

  // File sharing demo
  document
    .getElementById('share-file-demo')
    ?.addEventListener('click', async () => {
      // Create a simple text file to share
      const content = `WebKit PWA Features Demo

This file was shared using the Web Share API Level 2+!

Features demonstrated:
- Web Share API with file support
- View Transitions API
- Enhanced PWA manifest
- WebKit/Safari optimizations

Visit: ${window.location.origin}`;

      const file = new File([content], 'webkit-features-demo.txt', {
        type: 'text/plain',
      });

      try {
        await shareFile(file, {
          title: 'WebKit Features Demo File',
          text: 'Check out this demo file showcasing Web Share API Level 2+ capabilities!',
        });
      } catch (error) {
        console.error('File sharing failed:', error);
      }
    });

  // Element transition demo
  document
    .getElementById('element-transition-demo')
    ?.addEventListener('click', async (event) => {
      const button = event.target as HTMLButtonElement;
      const originalContent = button.innerHTML;

      try {
        await transitionElement(
          button,
          async () => {
            // Simulate content change
            button.innerHTML = `
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
          </svg>
          Transition Complete!
        `;
            button.className = button.className.replace(
              'bg-accent',
              'bg-green-500'
            );

            // Wait a moment to show the change
            await new Promise((resolve) => setTimeout(resolve, 1000));
          },
          {
            className: 'demo-element',
            duration: 300,
          }
        );

        // Reset after delay
        setTimeout(() => {
          button.innerHTML = originalContent;
          button.className = button.className.replace(
            'bg-green-500',
            'bg-accent'
          );
        }, 2000);
      } catch (error) {
        console.error('Element transition failed:', error);
        // Reset immediately on error
        button.innerHTML = originalContent;
      }
    });

  // Log feature support on page load
  document.addEventListener('DOMContentLoaded', async () => {
    console.log('🚀 WebKit Features Demo Loaded');
    console.log('📱 Web Share API supported:', isWebShareSupported());
    console.log(
      '✨ View Transitions API supported:',
      isViewTransitionsSupported()
    );

    // Add feature detection classes to body for styling
    if (isWebShareSupported()) {
      document.body.classList.add('supports-web-share');
    }

    if (isViewTransitionsSupported()) {
      document.body.classList.add('supports-view-transitions');
    }

    // Collect debug information
    const debugInfo = {
      userAgent: navigator.userAgent,
      platform: navigator.platform,
      vendor: navigator.vendor,
      standalone: window.matchMedia('(display-mode: standalone)').matches,
      webShareSupported: isWebShareSupported(),
      webShareLevel2: 'canShare' in navigator,
      viewTransitionsSupported: isViewTransitionsSupported(),
      serviceWorkerSupported: 'serviceWorker' in navigator,
      serviceWorkerStatus: null as string | null,
      manifestInstalled: false,
      errors: [] as string[],
    };

    // Check service worker status
    if ('serviceWorker' in navigator) {
      try {
        const registration = await navigator.serviceWorker.getRegistration();
        if (registration) {
          debugInfo.serviceWorkerStatus = registration.active
            ? 'active'
            : 'installing';
        } else {
          debugInfo.serviceWorkerStatus = 'not registered';
        }
      } catch (error) {
        debugInfo.errors.push(
          `Service Worker check error: ${error instanceof Error ? error.message : String(error)}`
        );
      }
    }

    // Check if app is installed
    if ('getInstalledRelatedApps' in navigator) {
      try {
        const relatedApps = await (navigator as any).getInstalledRelatedApps();
        debugInfo.manifestInstalled = relatedApps.length > 0;
      } catch (error) {
        debugInfo.errors.push(
          `Installed apps check error: ${error instanceof Error ? error.message : String(error)}`
        );
      }
    }

    // Display debug information
    const debugElement = document.getElementById('debug-info');
    if (debugElement) {
      debugElement.innerHTML = `
        <div class="grid gap-2">
          <div class="flex justify-between">
            <span class="text-text-secondary">Browser:</span>
            <span class="${navigator.vendor.includes('Apple') ? 'text-yellow-500' : 'text-green-500'}">${navigator.vendor || 'Unknown'}</span>
          </div>
          <div class="flex justify-between">
            <span class="text-text-secondary">Platform:</span>
            <span>${debugInfo.platform}</span>
          </div>
          <div class="flex justify-between">
            <span class="text-text-secondary">Standalone Mode:</span>
            <span class="${debugInfo.standalone ? 'text-green-500' : 'text-red-500'}">${debugInfo.standalone ? 'Yes' : 'No'}</span>
          </div>
          <div class="flex justify-between">
            <span class="text-text-secondary">Web Share API:</span>
            <span class="${debugInfo.webShareSupported ? 'text-green-500' : 'text-red-500'}">${debugInfo.webShareSupported ? 'Supported' : 'Not Supported'}</span>
          </div>
          <div class="flex justify-between">
            <span class="text-text-secondary">Web Share Level 2+:</span>
            <span class="${debugInfo.webShareLevel2 ? 'text-green-500' : 'text-yellow-500'}">${debugInfo.webShareLevel2 ? 'Supported' : 'Level 1 Only'}</span>
          </div>
          <div class="flex justify-between">
            <span class="text-text-secondary">View Transitions API:</span>
            <span class="${debugInfo.viewTransitionsSupported ? 'text-green-500' : 'text-red-500'}">${debugInfo.viewTransitionsSupported ? 'Supported' : 'Not Supported'}</span>
          </div>
          <div class="flex justify-between">
            <span class="text-text-secondary">Service Worker:</span>
            <span class="${debugInfo.serviceWorkerStatus === 'active' ? 'text-green-500' : debugInfo.serviceWorkerStatus === 'installing' ? 'text-yellow-500' : 'text-red-500'}">${debugInfo.serviceWorkerStatus || 'Not Supported'}</span>
          </div>
          ${
            debugInfo.errors.length > 0
              ? `
            <div class="mt-4 p-4 bg-red-500/10 rounded-lg">
              <p class="text-red-500 font-semibold mb-2">Errors Detected:</p>
              ${debugInfo.errors.map((error) => `<p class="text-sm text-red-400">• ${error}</p>`).join('')}
            </div>
          `
              : ''
          }
        </div>
      `;
    }
  });
</script>

<style>
  /* Feature-specific styling */
  .supports-web-share .web-share-enhanced {
    border-left: 3px solid var(--color-accent);
  }

  .supports-view-transitions .view-transitions-enhanced {
    border-left: 3px solid var(--color-primary);
  }

  /* Demo-specific animations */
  .demo-element {
    view-transition-name: demo-element;
  }

  /* Custom view transition styles */
  ::view-transition-old(demo-element) {
    animation: demo-slide-out 0.3s ease-in-out;
  }

  ::view-transition-new(demo-element) {
    animation: demo-slide-in 0.3s ease-in-out;
  }

  @keyframes demo-slide-out {
    from {
      transform: scale(1) rotate(0deg);
      opacity: 1;
    }
    to {
      transform: scale(0.8) rotate(-5deg);
      opacity: 0;
    }
  }

  @keyframes demo-slide-in {
    from {
      transform: scale(0.8) rotate(5deg);
      opacity: 0;
    }
    to {
      transform: scale(1) rotate(0deg);
      opacity: 1;
    }
  }

  /* Reduced motion fallback */
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(demo-element),
    ::view-transition-new(demo-element) {
      animation: demo-fade 0.1s ease-in-out;
    }

    @keyframes demo-fade {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }
  }
</style>
