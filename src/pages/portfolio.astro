---
import Layout from '../layouts/Layout.astro';
import { strapiAPI } from '../lib/strapi';
import type { Portfolio } from '../lib/strapi';
import PortfolioCard from '../components/PortfolioCard.astro';
import PortfolioFilter from '../components/PortfolioFilter.astro';
import AsymmetricGrid from '../components/grids/AsymmetricGrid.astro';
import { PerformanceMonitor, CacheManager } from '../lib/cache';

// Fetch portfolio items from Strapi
let portfolioItems: Portfolio[] = [];
let availableMediaTypes: string[] = [];
let availableTags: string[] = [];

try {
  console.log('🎯 Portfolio page: Fetching portfolio items from Strapi...');

  // Use performance monitoring for build-time optimization
  portfolioItems = await PerformanceMonitor.monitorApiCall(
    'Portfolio Items Fetch',
    () => strapiAPI.getPortfolioItems()
  );

  if (portfolioItems.length > 0) {
    // Extract available media types
    availableMediaTypes = [
      ...new Set(portfolioItems.map((item) => item.mediaType)),
    ];

    // Extract and flatten tags
    const allTags = portfolioItems
      .map((item) => item.tags || '')
      .join(',')
      .split(',')
      .map((tag) => tag.trim())
      .filter((tag) => tag.length > 0);
    availableTags = [...new Set(allTags)].sort();

    console.log(
      `✅ Portfolio: Loaded ${portfolioItems.length} items with ${availableMediaTypes.length} media types and ${availableTags.length} unique tags`
    );

    // Log cache performance after data fetch
    CacheManager.logCachePerformance();
  } else {
    console.log('⚠️ Portfolio: No portfolio items found in Strapi');
  }
} catch (error) {
  console.error('❌ Portfolio: Error fetching portfolio items:', error);
}

// SEO and page metadata
const title = 'Portfolio - I Did';
const description =
  portfolioItems.length > 0
    ? `Explore ${portfolioItems.length} projects showcasing ${availableMediaTypes.join(', ')} work across various technologies and creative endeavors.`
    : 'Portfolio showcase of creative and technical projects - coming soon with dynamic content.';
---

<Layout title={title} description={description}>
  <main class="portfolio-page">
    <!-- Hero Section -->
    <section aria-labelledby="portfolio-title">
      <div class="container">
        <div class="portfolio-hero">
          <header class="portfolio-hero__content">
            <h1 id="portfolio-title" class="portfolio-hero__title">
              I Did<span class="portfolio-hero__accent">.</span>
            </h1>
            <p class="portfolio-hero__description">
              {
                portfolioItems.length > 0
                  ? `A curated collection of ${portfolioItems.length} projects spanning ${availableMediaTypes.join(', ')} and more. Each piece tells a story of problem-solving, creativity, and technical execution.`
                  : 'A curated collection of creative and technical projects. Currently building this dynamic showcase - check back soon for the full experience!'
              }
            </p>
          </header>
        </div>
      </div>
    </section>

    <!-- Main Content -->
    <section class="portfolio-main" aria-labelledby="portfolio-grid-title">
      <div class="container">
        {
          portfolioItems.length > 0 ? (
            <>
              {/* Horizontal Filter Bar */}
              <PortfolioFilter
                availableMediaTypes={availableMediaTypes}
                availableTags={availableTags}
                class="portfolio-filter--horizontal"
              />

              {/* Portfolio Grid */}
              <div class="portfolio-content">
                {/* Grid Container with Masonry Layout */}
                <div class="portfolio-grid" id="portfolio-grid">
                  <AsymmetricGrid
                    variant="chaos"
                    gap="gap-8"
                    class="portfolio-asymmetric-grid"
                  >
                    {portfolioItems.map((item) => (
                      <PortfolioCard
                        item={item}
                        variant={item.featured ? 'featured' : 'standard'}
                        class="portfolio-grid__item"
                        data-media-type={item.mediaType}
                        data-featured={item.featured ? 'true' : 'false'}
                      />
                    ))}
                  </AsymmetricGrid>
                </div>

                {/* Empty State (hidden initially, shown when no results) */}
                <div
                  class="portfolio-empty"
                  id="portfolio-empty"
                  aria-hidden="true"
                >
                  <div class="portfolio-empty__content">
                    <h3 class="portfolio-empty__title">No Projects Found</h3>
                    <p class="portfolio-empty__description">
                      Try adjusting your filters or search terms to find more
                      projects.
                    </p>
                    <button
                      type="button"
                      class="portfolio-empty__reset"
                      onclick="document.querySelector('#reset-filters')?.click()"
                    >
                      Reset Filters
                    </button>
                  </div>
                </div>
              </div>
            </>
          ) : (
            <div class="portfolio-coming-soon">
              <div class="portfolio-coming-soon__content">
                <h2 class="portfolio-coming-soon__title">
                  Portfolio Coming Soon
                </h2>
                <p class="portfolio-coming-soon__description">
                  I'm currently setting up the dynamic portfolio system with
                  Strapi CMS. This will feature filterable project galleries,
                  detailed case studies, and interactive media presentations.
                  Check back soon for the full experience!
                </p>
                <div class="portfolio-coming-soon__features">
                  <div class="feature-card">
                    <h3 class="feature-card__title">Multi-Media</h3>
                    <p class="feature-card__description">
                      Code, design, video, audio, and more
                    </p>
                  </div>
                  <div class="feature-card">
                    <h3 class="feature-card__title">Smart Filtering</h3>
                    <p class="feature-card__description">
                      Find projects by type, tech, or tags
                    </p>
                  </div>
                  <div class="feature-card">
                    <h3 class="feature-card__title">Dynamic Content</h3>
                    <p class="feature-card__description">
                      Real-time updates from CMS
                    </p>
                  </div>
                </div>
                <div class="portfolio-coming-soon__actions">
                  <a href="/services" class="cta-primary">
                    View My Services
                  </a>
                  <a href="/i-am" class="cta-secondary">
                    Learn About Me
                  </a>
                </div>
              </div>
            </div>
          )
        }
      </div>
    </section>
  </main>
</Layout>

<style>
  @reference "../styles/tailwind-theme.css";

  /* Portfolio Page Styles */
  .portfolio-page {
    min-height: 100vh;
    background: var(--background-gradient);
  }

  /* Container for consistent centering */
  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Hero Section - Standardized floating container */
  .portfolio-hero {
    position: relative;
    background: var(--glass-bg-primary);
    backdrop-filter: blur(var(--glass-blur-navigation));
    border: 1px solid var(--glass-border-light);
    border-radius: var(--glass-radius-2xl);
    padding: 2.67rem 1.33rem;
    margin: 1.33rem 0 2.67rem 0;
    text-align: center;
    overflow: hidden;
  }

  .portfolio-hero__content {
    text-align: center;
    max-width: 533px;
    margin: 0 auto;
  }

  .portfolio-hero__title {
    /* Use Tailwind for common properties */
    @apply font-bold text-center;

    /* Use CSS variables for theme-specific properties */
    font-size: clamp(1.67rem, 3.33vw, 2.67rem);
    color: var(--color-text-primary);
    margin-bottom: var(--space-sm);
    line-height: 1.1;
  }

  .portfolio-hero__accent {
    color: var(--color-accent-primary);
  }

  .portfolio-hero__description {
    font-size: 0.83rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--spacing-xl);
  }

  /* Stats */
  .portfolio-hero__stats {
    display: flex;
    justify-content: center;
    gap: var(--spacing-xl);
    flex-wrap: wrap;
  }

  .portfolio-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-xs);
  }

  .portfolio-stat__number {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-accent-primary);
  }

  .portfolio-stat__label {
    font-size: 0.875rem;
    color: var(--color-text-tertiary);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* Main Layout */
  .portfolio-main {
    padding: var(--space-xl) 0;
  }

  /* Content Area */
  .portfolio-content {
    width: 100%;
  }

  /* Portfolio Grid Enhancements */
  .portfolio-asymmetric-grid {
    min-height: 400px;
  }

  .portfolio-grid__item {
    /* Items will inherit their styling from PortfolioCard */
    transition: all 0.3s ease;
  }

  .portfolio-grid__item[data-hidden='true'] {
    display: none;
  }

  /* Empty State */
  .portfolio-empty {
    display: none;
    padding: var(--space-xl) 0;
    text-align: center;
  }

  .portfolio-empty[aria-hidden='false'] {
    display: block;
  }

  .portfolio-empty__content {
    background: var(--glass-bg-secondary);
    backdrop-filter: blur(var(--glass-blur-container));
    border: 1px solid var(--glass-border-light);
    border-radius: var(--glass-radius);
    padding: var(--space-xl);
    max-width: 500px;
    margin: 0 auto;
  }

  .portfolio-empty__title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: var(--space-sm);
  }

  .portfolio-empty__description {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-lg);
    line-height: 1.6;
  }

  .portfolio-empty__reset {
    padding: var(--space-md) var(--space-lg);
    background: var(--color-accent-primary);
    color: white;
    border: none;
    border-radius: calc(var(--glass-radius) * 0.5);
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .portfolio-empty__reset:hover {
    background: var(--color-accent-secondary);
    transform: translateY(-2px);
  }

  /* Coming Soon State */
  .portfolio-coming-soon {
    grid-column: 1 / -1;
    padding: var(--spacing-xl) 0;
  }

  .portfolio-coming-soon__content {
    text-align: center;
    background: var(--color-glass-bg-light);
    backdrop-filter: blur(var(--glass-blur-light));
    border: 1px solid var(--color-glass-border-light);
    border-radius: var(--glass-radius);
    box-shadow: var(--glass-shadow-light);
    padding: var(--spacing-xl);
    max-width: 900px;
    margin: 0 auto;
  }

  .portfolio-coming-soon__icon {
    font-size: 4rem;
    margin-bottom: var(--spacing-lg);
  }

  .portfolio-coming-soon__title {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-md);
  }

  .portfolio-coming-soon__description {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--spacing-xl);
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Feature Cards */
  .portfolio-coming-soon__features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-xl);
  }

  .feature-card {
    background: var(--color-glass-bg-medium);
    border: 1px solid var(--color-glass-border-medium);
    border-radius: var(--glass-radius);
    padding: var(--spacing-lg);
    text-align: center;
  }

  .feature-card__icon {
    font-size: 2.5rem;
    margin-bottom: var(--spacing-md);
  }

  .feature-card__title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-sm);
  }

  .feature-card__description {
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  /* Action Buttons */
  .portfolio-coming-soon__actions {
    display: flex;
    gap: var(--spacing-md);
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-primary,
  .cta-secondary {
    display: inline-block;
    padding: var(--spacing-md) var(--spacing-lg);
    border-radius: var(--glass-radius);
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .cta-primary {
    background: var(--color-accent-primary);
    color: white;
    border: 1px solid var(--color-accent-primary);
  }

  .cta-primary:hover {
    background: var(--color-accent-secondary);
    border-color: var(--color-accent-secondary);
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
  }

  .cta-secondary {
    background: transparent;
    color: var(--color-text-primary);
    border: 1px solid var(--color-glass-border-medium);
  }

  .cta-secondary:hover {
    background: var(--color-glass-bg-medium);
    border-color: var(--color-glass-border-heavy);
    transform: translateY(-2px);
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .portfolio-hero {
      padding: var(--space-xl) 0;
    }

    .portfolio-main {
      padding: var(--space-lg) 0;
    }

    .container {
      padding: 0 1rem;
    }
  }

  @media (max-width: 640px) {
    .portfolio-hero__stats {
      flex-direction: column;
      gap: var(--space-md);
    }

    .portfolio-coming-soon__actions {
      flex-direction: column;
      align-items: center;
    }

    .cta-primary,
    .cta-secondary {
      width: 100%;
      max-width: 280px;
      text-align: center;
    }

    .portfolio-coming-soon__features {
      grid-template-columns: 1fr;
    }
  }

  /* Print Styles */
  @media print {
    .portfolio-sidebar {
      display: none;
    }

    .portfolio-layout {
      grid-template-columns: 1fr;
    }

    .portfolio-coming-soon__actions {
      display: none;
    }
  }

  /* Loading and Animation States */
  .portfolio-grid {
    opacity: 1;
    transition: opacity 0.3s ease;
  }

  .portfolio-grid[data-loading='true'] {
    opacity: 0.7;
  }

  /* Focus and Accessibility */
  .portfolio-page:focus-within .portfolio-grid__item:not(:focus-within) {
    opacity: 0.8;
  }

  @media (prefers-reduced-motion: reduce) {
    .portfolio-grid__item,
    .cta-primary,
    .cta-secondary,
    .portfolio-empty__reset {
      transition: none;
    }

    .cta-primary:hover,
    .cta-secondary:hover,
    .portfolio-empty__reset:hover {
      transform: none;
    }
  }
</style>

<script>
  // Initialize caching when the page loads
  import { initializeCacheOptimizations } from '../lib/cache';

  // Initialize cache optimizations
  initializeCacheOptimizations();
  console.log('✅ Cache optimizations initialized for portfolio page');
</script>

<script is:inline>
  // Portfolio Grid JavaScript for filtering and interactions
  document.addEventListener('DOMContentLoaded', function () {
    const portfolioGrid = document.getElementById('portfolio-grid');
    const portfolioEmpty = document.getElementById('portfolio-empty');
    const portfolioItems = document.querySelectorAll('.portfolio-grid__item');

    if (!portfolioGrid || !portfolioItems.length) return;

    // Listen for filter events from PortfolioFilter component
    document.addEventListener('portfolio-filter-change', function (event) {
      const filterData = event.detail;
      filterPortfolioItems(filterData);
    });

    document.addEventListener('portfolio-search', function (event) {
      const { searchTerm } = event.detail;
      searchPortfolioItems(searchTerm);
    });

    document.addEventListener('portfolio-filter-reset', function () {
      showAllItems();
    });

    function filterPortfolioItems(filterData) {
      const { mediaTypes, statuses, tags, sort } = filterData;
      let visibleItems = Array.from(portfolioItems);

      // Filter by media types (if any selected)
      if (mediaTypes && mediaTypes.length > 0) {
        visibleItems = visibleItems.filter((item) => {
          const itemMediaType = item.getAttribute('data-media-type');
          return mediaTypes.includes(itemMediaType);
        });
      }

      // Filter by statuses (if any selected)
      if (statuses && statuses.length > 0) {
        visibleItems = visibleItems.filter((item) => {
          if (statuses.includes('featured')) {
            return item.getAttribute('data-featured') === 'true';
          }
          if (statuses.includes('completed')) {
            // Assuming all items are completed for now
            return true;
          }
          return true;
        });
      }

      // Filter by tags (if any selected)
      if (tags && tags.length > 0) {
        visibleItems = visibleItems.filter((item) => {
          // This would need to be implemented based on how tags are stored in the item
          // For now, we'll assume all items match
          return true;
        });
      }

      // Hide/show items
      portfolioItems.forEach((item) => {
        const shouldShow = visibleItems.includes(item);
        item.setAttribute('data-hidden', shouldShow ? 'false' : 'true');
        item.style.display = shouldShow ? '' : 'none';
      });

      // Update empty state
      updateEmptyState(visibleItems.length);

      // Update results count
      updateResultsCount(visibleItems.length);

      // Apply sorting if needed
      if (sort && sort !== 'priority') {
        applySorting(visibleItems, sort);
      }
    }

    function searchPortfolioItems(searchTerm) {
      if (!searchTerm) {
        showAllItems();
        return;
      }

      const visibleItems = [];

      portfolioItems.forEach((item) => {
        const title =
          item.querySelector('.portfolio-title')?.textContent?.toLowerCase() ||
          '';
        const description =
          item
            .querySelector('.portfolio-description')
            ?.textContent?.toLowerCase() || '';
        const technologies = Array.from(item.querySelectorAll('.tech-tag'))
          .map((tech) => tech.textContent?.toLowerCase() || '')
          .join(' ');

        const searchContent = `${title} ${description} ${technologies}`;
        const matches = searchContent.includes(searchTerm);

        item.setAttribute('data-hidden', matches ? 'false' : 'true');
        item.style.display = matches ? '' : 'none';

        if (matches) {
          visibleItems.push(item);
        }
      });

      updateEmptyState(visibleItems.length);
      updateResultsCount(visibleItems.length);
    }

    function showAllItems() {
      portfolioItems.forEach((item) => {
        item.setAttribute('data-hidden', 'false');
        item.style.display = '';
      });

      updateEmptyState(portfolioItems.length);
      updateResultsCount(portfolioItems.length);
    }

    function updateEmptyState(visibleCount) {
      if (portfolioEmpty) {
        portfolioEmpty.setAttribute(
          'aria-hidden',
          visibleCount === 0 ? 'false' : 'true'
        );
      }
    }

    function updateResultsCount(count) {
      const resultsCount = document.querySelector('#results-count');
      if (resultsCount) {
        const totalCount = portfolioItems.length;
        if (count === totalCount) {
          resultsCount.textContent = `Showing all ${count} project${count !== 1 ? 's' : ''}`;
        } else {
          resultsCount.textContent = `Showing ${count} of ${totalCount} project${totalCount !== 1 ? 's' : ''}`;
        }
      }
    }

    function applySorting(items, sortType) {
      // This would implement different sorting algorithms
      // For now, we'll keep the default priority-based ordering
      console.log(`Sorting by: ${sortType}`);
    }

    // Initialize results count
    updateResultsCount(portfolioItems.length);
  });
</script>
