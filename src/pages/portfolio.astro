---
import Layout from '../layouts/Layout.astro';
import { strapiAPI } from '../lib/strapi';
import type { Portfolio } from '../lib/strapi';
import PortfolioCard from '../components/PortfolioCard.astro';
import PortfolioFilter from '../components/PortfolioFilter.astro';
import LazyGrid from '../components/LazyGrid.astro';
import { PerformanceMonitor, preloadBuildData } from '../lib/cache';

// Fetch portfolio items from Strapi with caching optimization
let portfolioItems: Portfolio[] = [];
let availableMediaTypes: string[] = [];
let availableTags: string[] = [];

try {
  console.log('🎯 Portfolio page: Fetching portfolio items from Strapi...');

  // Use performance monitoring for build-time optimization
  portfolioItems = await PerformanceMonitor.monitorApiCall(
    'Portfolio Items Fetch',
    () => strapiAPI.getPortfolioItems()
  );

  if (portfolioItems.length > 0) {
    // Extract available media types
    availableMediaTypes = [
      ...new Set(portfolioItems.map((item) => item.mediaType)),
    ];

    // Extract and flatten tags
    const allTags = portfolioItems
      .map((item) => item.tags || '')
      .join(',')
      .split(',')
      .map((tag) => tag.trim())
      .filter((tag) => tag.length > 0);
    availableTags = [...new Set(allTags)].sort();

    console.log(
      `✅ Portfolio: Loaded ${portfolioItems.length} items with ${availableMediaTypes.length} media types and ${availableTags.length} unique tags`
    );
  } else {
    console.log('⚠️ Portfolio: No portfolio items found in Strapi');
  }
} catch (error) {
  console.error('❌ Portfolio: Error fetching portfolio items:', error);
}

// SEO and page metadata
const title = 'Portfolio - I Did';
const description =
  portfolioItems.length > 0
    ? `Explore ${portfolioItems.length} projects showcasing ${availableMediaTypes.join(', ')} work across various technologies and creative endeavors.`
    : 'Portfolio showcase of creative and technical projects - coming soon with dynamic content.';
---

<Layout title={title} description={description}>
  <main class="portfolio-page">
    <div class="portfolio-container">
      <!-- Hero Section - Floating Glass Style -->
      <section class="hero-section">
        <h1 class="hero-title">
          <span class="hero-accent">I did</span> these things before<span
            class="hero-accent">.</span
          >
        </h1>
        <p class="hero-subtitle">
          {
            portfolioItems.length > 0
              ? `A curated collection of ${portfolioItems.length} projects spanning ${availableMediaTypes.join(', ')} and more. Each piece tells a story of problem-solving, creativity, and technical execution.`
              : 'A curated collection of creative and technical projects. Currently building this dynamic showcase - check back soon for the full experience!'
          }
        </p>
      </section>

      {
        portfolioItems.length > 0 ? (
          <>
            {/* Horizontal Filter Bar */}
            <div class="portfolio-filter-container">
              <PortfolioFilter
                availableMediaTypes={availableMediaTypes}
                availableTags={availableTags}
                class="portfolio-filter--horizontal"
              />
            </div>

            {/* Portfolio Content */}
            <div class="portfolio-content">
              {/* Grid Container with Lazy Loading */}
              <div class="portfolio-grid" id="portfolio-grid">
                <LazyGrid
                  variant="standard"
                  gap="gap-6"
                  class="portfolio-lazy-grid"
                  loadingStrategy="priority"
                  batchSize={6}
                  rootMargin="150px"
                >
                  {portfolioItems.map((item) => (
                    <PortfolioCard
                      item={item}
                      variant={item.featured ? 'featured' : 'standard'}
                      class="portfolio-grid__item"
                      data-media-type={item.mediaType}
                      data-featured={item.featured ? 'true' : 'false'}
                    />
                  ))}
                </LazyGrid>
              </div>

              {/* Empty State (hidden initially, shown when no results) */}
              <div
                class="portfolio-empty"
                id="portfolio-empty"
                aria-hidden="true"
              >
                <div class="portfolio-empty__content">
                  <div class="portfolio-empty__icon">
                    <svg
                      width="48"
                      height="48"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <circle cx="11" cy="11" r="8" />
                      <path d="m21 21-4.35-4.35" />
                    </svg>
                  </div>
                  <h3 class="portfolio-empty__title">No Projects Found</h3>
                  <p class="portfolio-empty__description">
                    Try adjusting your filters or search terms to find more
                    projects.
                  </p>
                  <button
                    type="button"
                    class="portfolio-empty__reset"
                    onclick="document.querySelector('#reset-filters')?.click()"
                  >
                    Reset Filters
                  </button>
                </div>
              </div>
            </div>
          </>
        ) : (
          <div class="portfolio-coming-soon">
            <div class="portfolio-coming-soon__content">
              <div class="portfolio-coming-soon__icon">
                <svg
                  width="64"
                  height="64"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
                </svg>
              </div>
              <h2 class="portfolio-coming-soon__title">
                Portfolio Coming Soon
              </h2>
              <p class="portfolio-coming-soon__description">
                I'm currently setting up the dynamic portfolio system with
                Strapi CMS. This will feature filterable project galleries,
                detailed case studies, and interactive media presentations.
                Check back soon for the full experience!
              </p>
              <div class="portfolio-coming-soon__features">
                <div class="feature-card">
                  <div class="feature-card__icon">
                    <svg
                      width="32"
                      height="32"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2v11z" />
                    </svg>
                  </div>
                  <h3 class="feature-card__title">Multi-Media</h3>
                  <p class="feature-card__description">
                    Code, design, video, audio, and more
                  </p>
                </div>
                <div class="feature-card">
                  <div class="feature-card__icon">
                    <svg
                      width="32"
                      height="32"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <circle cx="11" cy="11" r="8" />
                      <path d="m21 21-4.35-4.35" />
                    </svg>
                  </div>
                  <h3 class="feature-card__title">Smart Filtering</h3>
                  <p class="feature-card__description">
                    Find projects by type, tech, or tags
                  </p>
                </div>
                <div class="feature-card">
                  <div class="feature-card__icon">
                    <svg
                      width="32"
                      height="32"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                    </svg>
                  </div>
                  <h3 class="feature-card__title">Dynamic Content</h3>
                  <p class="feature-card__description">
                    Real-time updates from CMS
                  </p>
                </div>
              </div>
              <div class="portfolio-coming-soon__actions">
                <a href="/services" class="cta-primary">
                  View My Services
                </a>
                <a href="/i-am" class="cta-secondary">
                  Learn About Me
                </a>
              </div>
            </div>
          </div>
        )
      }
    </div>
  </main>
</Layout>

<style>
  /* Portfolio Page Styles */
  .portfolio-page {
    min-height: 100vh;
    background: var(--background-gradient);
  }

  /* Main Container */
  .portfolio-container {
    min-height: 100vh;
    padding-top: 120px;
    padding-bottom: 120px;
    padding-left: 1rem;
    padding-right: 1rem;
    max-width: 100vw;
  }

  /* Hero Section - Floating Glass Style (matching I Am page) */
  .hero-section {
    background: var(--glass-bg-primary);
    backdrop-filter: blur(var(--glass-blur-navigation));
    border: 1px solid var(--glass-border-light);
    border-radius: var(--glass-radius-xl);
    padding: 4rem 2rem;
    margin: 2rem auto 4rem auto;
    text-align: center;
    position: relative;
    overflow: hidden;
    max-width: 1200px;
  }

  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    color: var(--color-text-primary);
    margin: 0 0 1rem 0;
    line-height: 1.1;
  }

  .hero-accent {
    color: var(--color-accent-primary);
  }

  .hero-subtitle {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Container override to ensure proper margins */
  .portfolio-container {
    max-width: 1400px;
    margin: 0 auto;
  }

  /* Horizontal Filter Container */
  .portfolio-filter-container {
    margin-bottom: var(--space-xl);
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Portfolio Grid Enhancements */
  .portfolio-lazy-grid {
    min-height: 400px;
    display: grid !important;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)) !important;
    gap: var(--space-xl) !important;
    max-width: 1400px;
    margin: 0 auto;
    padding: var(--space-lg);
  }

  .portfolio-grid__item {
    transition: all 0.3s ease;
    grid-column: span 1 !important;
    width: 100%;
    min-width: 400px;
  }

  .portfolio-grid__item[data-hidden='true'] {
    display: none;
  }

  /* Responsive Grid Breakpoints */
  @media (max-width: 1200px) {
    .portfolio-lazy-grid {
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)) !important;
      padding: var(--space-md);
    }

    .portfolio-grid__item {
      min-width: 350px;
    }
  }

  @media (max-width: 768px) {
    .portfolio-lazy-grid {
      grid-template-columns: 1fr !important;
      gap: var(--space-lg) !important;
      padding: var(--space-sm);
    }

    .portfolio-grid__item {
      min-width: unset;
      width: 100%;
    }
  }

  @media (max-width: 480px) {
    .portfolio-lazy-grid {
      padding: var(--space-xs);
      gap: var(--space-md) !important;
    }
  }

  /* Empty State */
  .portfolio-empty {
    display: none;
    padding: var(--space-xl) 0;
    text-align: center;
  }

  .portfolio-empty[aria-hidden='false'] {
    display: block;
  }

  .portfolio-empty__content {
    background: var(--glass-bg-primary);
    backdrop-filter: blur(var(--glass-blur-container));
    border: 1px solid var(--glass-border-medium);
    border-radius: var(--glass-radius);
    padding: var(--space-xl);
    max-width: 500px;
    margin: 0 auto;
  }

  .portfolio-empty__icon {
    margin-bottom: var(--space-lg);
    opacity: 0.6;
    color: var(--color-text-tertiary);
  }

  .portfolio-empty__title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: var(--space-sm);
  }

  .portfolio-empty__description {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-lg);
    line-height: 1.6;
  }

  .portfolio-empty__reset {
    padding: var(--space-md) var(--space-lg);
    background: var(--color-accent-primary);
    color: white;
    border: none;
    border-radius: calc(var(--glass-radius) * 0.5);
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .portfolio-empty__reset:hover {
    background: var(--color-accent-secondary);
    transform: translateY(-2px);
  }

  /* Coming Soon State */
  .portfolio-coming-soon {
    padding: var(--space-xl) 0;
  }

  .portfolio-coming-soon__content {
    text-align: center;
    background: var(--glass-bg-primary);
    backdrop-filter: blur(var(--glass-blur-container));
    border: 1px solid var(--glass-border-medium);
    border-radius: var(--glass-radius);
    box-shadow: 0 8px 32px var(--glass-shadow-light);
    padding: var(--space-xl);
    max-width: 900px;
    margin: 0 auto;
  }

  .portfolio-coming-soon__icon {
    margin-bottom: var(--space-lg);
    color: var(--color-text-tertiary);
  }

  .portfolio-coming-soon__title {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: var(--space-md);
  }

  .portfolio-coming-soon__description {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-xl);
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Feature Cards */
  .portfolio-coming-soon__features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .feature-card {
    background: var(--glass-bg-secondary);
    border: 1px solid var(--glass-border-medium);
    border-radius: var(--glass-radius);
    padding: var(--space-lg);
    text-align: center;
  }

  .feature-card__icon {
    margin-bottom: var(--space-md);
    color: var(--color-accent-primary);
  }

  .feature-card__title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: var(--space-sm);
  }

  .feature-card__description {
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  /* Action Buttons */
  .portfolio-coming-soon__actions {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-primary,
  .cta-secondary {
    display: inline-block;
    padding: var(--space-md) var(--space-lg);
    border-radius: var(--glass-radius);
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .cta-primary {
    background: var(--color-accent-primary);
    color: white;
    border: 1px solid var(--color-accent-primary);
    box-shadow: 0 4px 20px rgba(184, 134, 154, 0.25);
  }

  .cta-primary:hover {
    background: var(--color-accent-secondary);
    border-color: var(--color-accent-secondary);
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(0, 212, 255, 0.3);
  }

  .cta-secondary {
    background: var(--glass-bg-primary);
    backdrop-filter: blur(var(--glass-blur-button));
    color: var(--color-text-primary);
    border: 1px solid var(--glass-border-medium);
    box-shadow: 0 4px 16px var(--glass-shadow-light);
  }

  .cta-secondary:hover {
    background: var(--glass-bg-secondary);
    backdrop-filter: blur(calc(var(--glass-blur-button) + 4px));
    border-color: var(--glass-border-light);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px var(--glass-shadow-medium);
  }

  /* Responsive Design */
  @media (max-width: 1200px) {
    .portfolio-lazy-grid {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }

  @media (max-width: 768px) {
    .portfolio-container {
      padding-top: 100px;
      padding-bottom: 100px;
      padding-left: var(--space-md);
      padding-right: var(--space-md);
    }

    .hero-section {
      padding: 3rem 1.5rem;
      margin: 1rem auto 3rem auto;
    }

    .portfolio-lazy-grid {
      grid-template-columns: 1fr !important;
      gap: var(--space-md) !important;
    }
  }

  @media (max-width: 480px) {
    .portfolio-container {
      padding-top: 110px;
    }

    .hero-section {
      padding: 2rem 1rem;
    }
  }

  @media (max-width: 640px) {
    .portfolio-coming-soon__actions {
      flex-direction: column;
      align-items: center;
    }

    .cta-primary,
    .cta-secondary {
      width: 100%;
      max-width: 280px;
      text-align: center;
    }

    .portfolio-coming-soon__features {
      grid-template-columns: 1fr;
    }
  }

  /* Print Styles */
  @media print {
    .portfolio-filter-container {
      display: none;
    }

    .portfolio-coming-soon__actions {
      display: none;
    }
  }

  /* Loading and Animation States */
  .portfolio-grid {
    opacity: 1;
    transition: opacity 0.3s ease;
  }

  .portfolio-grid[data-loading='true'] {
    opacity: 0.7;
  }

  /* Focus and Accessibility */
  .portfolio-page:focus-within .portfolio-grid__item:not(:focus-within) {
    opacity: 0.8;
  }

  @media (prefers-reduced-motion: reduce) {
    .portfolio-grid__item,
    .cta-primary,
    .cta-secondary,
    .portfolio-empty__reset {
      transition: none;
    }

    .cta-primary:hover,
    .cta-secondary:hover,
    .portfolio-empty__reset:hover {
      transform: none;
    }
  }

  /* FINAL OVERRIDE: ensure portfolio grid uses responsive columns */
  .portfolio-lazy-grid {
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)) !important;
  }

  .portfolio-lazy-grid > .portfolio-grid__item {
    grid-column: auto !important;
  }
</style>

<script>
  import { initializeCacheOptimizations } from '../lib/cache';

  // Initialize caching when the page loads
  initializeCacheOptimizations();
</script>

<script is:inline>
  // Portfolio Grid JavaScript for filtering and interactions
  document.addEventListener('DOMContentLoaded', function () {
    const portfolioGrid = document.getElementById('portfolio-grid');
    const portfolioEmpty = document.getElementById('portfolio-empty');
    const portfolioItems = document.querySelectorAll('.portfolio-grid__item');

    if (!portfolioGrid || !portfolioItems.length) return;

    // Listen for filter events from PortfolioFilter component
    document.addEventListener('portfolio-filter-change', function (event) {
      const filterData = event.detail;
      filterPortfolioItems(filterData);
    });

    document.addEventListener('portfolio-search', function (event) {
      const { searchTerm } = event.detail;
      searchPortfolioItems(searchTerm);
    });

    document.addEventListener('portfolio-filter-reset', function () {
      showAllItems();
    });

    function filterPortfolioItems(filterData) {
      const { mediaType, status, sort } = filterData;
      let visibleItems = Array.from(portfolioItems);

      // Filter by media type
      if (mediaType !== 'all') {
        visibleItems = visibleItems.filter(
          (item) => item.getAttribute('data-media-type') === mediaType
        );
      }

      // Filter by status
      if (status === 'featured') {
        visibleItems = visibleItems.filter(
          (item) => item.getAttribute('data-featured') === 'true'
        );
      }

      // Hide/show items
      portfolioItems.forEach((item) => {
        const shouldShow = visibleItems.includes(item);
        item.setAttribute('data-hidden', shouldShow ? 'false' : 'true');
        item.style.display = shouldShow ? '' : 'none';
      });

      // Update empty state
      updateEmptyState(visibleItems.length);

      // Update results count
      updateResultsCount(visibleItems.length);

      // Apply sorting if needed
      if (sort && sort !== 'priority') {
        applySorting(visibleItems, sort);
      }
    }

    function searchPortfolioItems(searchTerm) {
      if (!searchTerm) {
        showAllItems();
        return;
      }

      const visibleItems = [];

      portfolioItems.forEach((item) => {
        const title =
          item
            .querySelector('.portfolio-card__title')
            ?.textContent?.toLowerCase() || '';
        const description =
          item
            .querySelector('.portfolio-card__description')
            ?.textContent?.toLowerCase() || '';
        const technologies = Array.from(
          item.querySelectorAll('.portfolio-card__tech-tag')
        )
          .map((tech) => tech.textContent?.toLowerCase() || '')
          .join(' ');

        const searchContent = `${title} ${description} ${technologies}`;
        const matches = searchContent.includes(searchTerm);

        item.setAttribute('data-hidden', matches ? 'false' : 'true');
        item.style.display = matches ? '' : 'none';

        if (matches) {
          visibleItems.push(item);
        }
      });

      updateEmptyState(visibleItems.length);
      updateResultsCount(visibleItems.length);
    }

    function showAllItems() {
      portfolioItems.forEach((item) => {
        item.setAttribute('data-hidden', 'false');
        item.style.display = '';
      });

      updateEmptyState(portfolioItems.length);
      updateResultsCount(portfolioItems.length);
    }

    function updateEmptyState(visibleCount) {
      if (portfolioEmpty) {
        portfolioEmpty.setAttribute(
          'aria-hidden',
          visibleCount === 0 ? 'false' : 'true'
        );
      }
    }

    function updateResultsCount(count) {
      const resultsCount = document.querySelector('#results-count');
      if (resultsCount) {
        const totalCount = portfolioItems.length;
        if (count === totalCount) {
          resultsCount.textContent = `Showing all ${count} project${count !== 1 ? 's' : ''}`;
        } else {
          resultsCount.textContent = `Showing ${count} of ${totalCount} project${totalCount !== 1 ? 's' : ''}`;
        }
      }
    }

    function applySorting(items, sortType) {
      // This would implement different sorting algorithms
      // For now, we'll keep the default priority-based ordering
      console.log(`Sorting by: ${sortType}`);
    }

    // Initialize results count
    updateResultsCount(portfolioItems.length);
  });
</script>
