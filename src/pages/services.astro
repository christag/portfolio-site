    {
      id: 5,
      documentId: 'mock-5',
      title: 'IT Project Management & Implementation Support',
      description:
        'I will manage your IT projects to ensure they are delivered on-time, on-budget, and with real results. With my extensive background leading complex tech projects, I will handle the planning, coordination, and execution details.',
      category: 'Management',
      featureHighlights: [
        'Certified PMP Project Manager',
        'Fortune 500 Experience',
        'On-Time & On-Budget Delivery',
        'Cross-Functional Leadership',
      ],
      tiers: [
        {
          name: 'Basic',
          priceLow: 500,
          priceHigh: 500,
