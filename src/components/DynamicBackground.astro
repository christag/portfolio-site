  /* ==========================================================================
   HORIZONTAL GLITCH LINES - New feature
   ========================================================================== */

  .glitch-lines-container {
    position: absolute;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .glitch-line {
    position: absolute;
    height: 0.25%;
    opacity: 0;
    transform: translateX(-100%);

    // Light mode: black glitch lines with 20% opacity
    background: rgba(0, 0, 0, 0.2);

    // Dark mode: white glitch lines with 20% opacity
    html[data-theme='dark'] &,
    [data-theme='dark'] & {
      background: rgba(255, 255, 255, 0.2) !important;
    }
  }

  [data-glitch='true'] {
    .glitch-line--1 {
      animation: glitch-line-1 8s steps(1) infinite;
      animation-delay: 0s;
    }

    .glitch-line--2 {
      animation: glitch-line-2 6s steps(1) infinite;
      animation-delay: 1s;
    }

    .glitch-line--3 {
      animation: glitch-line-3 7s steps(1) infinite;
      animation-delay: 2s;
    }

    .glitch-line--4 {
      animation: glitch-line-4 5s steps(1) infinite;
      animation-delay: 0.5s;
    }

    .glitch-line--5 {
      animation: glitch-line-5 8s steps(1) infinite;
      animation-delay: 3s;
    }
  }

  // Generate random glitch line animations
  @keyframes glitch-line-1 {
    0%,
    92% {
      opacity: 0;
    }
    93% {
      opacity: 1;
      top: 15%;
      width: 60%;
      left: 65%;
    }
    96% {
      opacity: 0;
    }
  }

  @keyframes glitch-line-2 {
    0%,
    85% {
      opacity: 0;
    }
    86% {
      opacity: 1;
      top: 45%;
      width: 30%;
      left: 25%;
    }
    88% {
      opacity: 0;
    }
  }

  @keyframes glitch-line-3 {
    0%,
    88% {
      opacity: 0;
    }
    89% {
      opacity: 1;
      top: 70%;
      width: 80%;
      left: 5%;
    }
    92% {
      opacity: 0;
    }
  }

  @keyframes glitch-line-4 {
    0%,
    90% {
      opacity: 0;
    }
    91% {
      opacity: 1;
      top: 30%;
      width: 40%;
      left: 80%;
    }
    93% {
      opacity: 0;
    }
  }

  @keyframes glitch-line-5 {
    0%,
    87% {
      opacity: 0;
    }
    88% {
      opacity: 1;
      top: 55%;
      width: 70%;
      left: 45%;
    }
    90% {
      opacity: 0;
    }
  }

  /* ==========================================================================
   HIGH CONTRAST ELEMENTS - Black in light mode, white in dark mode
   ========================================================================== */

  .contrast-element {
    position: absolute;
    border-radius: 50%;
    filter: blur(3px); // Very sharp for maximum contrast
    opacity: 0;
    animation: contrast-pulse 6s ease-in-out infinite;
    pointer-events: none;

    // Light mode: sharp black elements for contrast
    background: radial-gradient(
      circle,
      rgba(0, 0, 0, 0.4) 0%,
      rgba(0, 0, 0, 0.15) 50%,
      transparent 100%
    );

    // Dark mode: sharp white elements for contrast
    html[data-theme='dark'] &,
    [data-theme='dark'] & {
      background: radial-gradient(
        circle,
        rgba(255, 255, 255, 0.3) 0%,
        rgba(255, 255, 255, 0.12) 50%,
        transparent 100%
      ) !important;
    }
  }

  .contrast-element--1 {
    width: 60px;
    height: 60px;
    top: 35%;
    left: 25%;
    animation-delay: 0s;
  }

  .contrast-element--2 {
    width: 45px;
    height: 45px;
    top: 55%;
    left: 70%;
    animation-delay: -2s;
  }

  .contrast-element--3 {
    width: 50px;
    height: 50px;
    top: 75%;
    left: 45%;
    animation-delay: -4s;
  }

  .contrast-element--4 {
    width: 40px;
    height: 40px;
    top: 20%;
    left: 75%;
    animation-delay: -1s;
  }

  @keyframes contrast-pulse {
    0%,
    60%,
    100% {
      opacity: 0;
      transform: scale(0.8);
    }
    20%,
    40% {
      opacity: 1;
      transform: scale(1.1);
    }
  }

  /* ==========================================================================
   GLITCH OVERLAY - Sharp contrast
   ========================================================================== */

  .glitch-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    animation: glitch-sweep 10s ease-in-out infinite;

    // Light mode: sharp black glitch for contrast
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 0, 0, 0.15) 50%,
      transparent 100%
    );

    // Dark mode: sharp white glitch
    html[data-theme='dark'] &,
    [data-theme='dark'] & {
      background: linear-gradient(
        90deg,
        transparent 0%,
        rgba(255, 255, 255, 0.15) 50%,
        transparent 100%
      ) !important;
    }
  }

  [data-glitch='true'] .glitch-overlay {
    animation: glitch-sweep 10s ease-in-out infinite;
  }

  @keyframes glitch-sweep {
    0%,
    85%,
    100% {
      opacity: 0;
      transform: translateX(-100%);
    }
    10%,
    20% {
      opacity: 0.8;
      transform: translateX(100%);
    }
  }

  /* ==========================================================================
   COLOR SPARKLES - Sharp, tiny color accents
   ========================================================================== */

  .color-sparkle {
    position: absolute;
    border-radius: 50%;
    filter: blur(0.5px); // Minimal blur for sharper sparkles
    opacity: 0;
    animation: sparkle-twinkle 8s ease-in-out infinite;
    pointer-events: none;
  }

  [data-color-accents='true'] .color-sparkle {
    animation: sparkle-twinkle 8s ease-in-out infinite;
  }

  .color-sparkle--1 {
    width: 20px; // Reduced from 40px
    height: 20px;
    top: 25%;
    left: 15%;
    animation-delay: 0s;

    // Light mode: sharp pink sparkle
    background: radial-gradient(
      circle,
      rgba(184, 134, 154, 0.8) 0%,
      rgba(184, 134, 154, 0.4) 50%,
      transparent 100%
    );

    // Dark mode: hidden
    html[data-theme='dark'] &,
    [data-theme='dark'] & {
      display: none !important;
    }
  }

  .color-sparkle--2 {
    width: 15px; // Reduced from 30px
    height: 15px;
    top: 65%;
    left: 75%;
    animation-delay: -2s;

    // Light mode: sharp pink sparkle (brand primary)
    background: radial-gradient(
      circle,
      rgba(184, 134, 154, 0.7) 0%,
      rgba(184, 134, 154, 0.35) 50%,
      transparent 100%
    );

    // Dark mode: hidden
    html[data-theme='dark'] &,
    [data-theme='dark'] & {
      display: none !important;
    }
  }

  .color-sparkle--3 {
    width: 18px; // Reduced from 35px
    height: 18px;
    top: 45%;
    left: 55%;
    animation-delay: -4s;

    // Light mode: sharp pink sparkle (brand primary)
    background: radial-gradient(
      circle,
      rgba(184, 134, 154, 0.65) 0%,
      rgba(184, 134, 154, 0.3) 50%,
      transparent 100%
    );

    // Dark mode: hidden
    html[data-theme='dark'] &,
    [data-theme='dark'] & {
      display: none !important;
    }
  }

  .color-sparkle--4 {
    width: 12px; // Reduced from 25px
    height: 12px;
    top: 15%;
    left: 85%;
    animation-delay: -1s;

    // Light mode: sharp pink sparkle
    background: radial-gradient(
      circle,
      rgba(184, 134, 154, 0.7) 0%,
      rgba(184, 134, 154, 0.35) 50%,
      transparent 100%
    );

    // Dark mode: hidden
    html[data-theme='dark'] &,
    [data-theme='dark'] & {
      display: none !important;
    }
  }

  .color-sparkle--5 {
    width: 16px; // Reduced from 32px
    height: 16px;
    top: 80%;
    left: 25%;
    animation-delay: -3s;

    // Light mode: sharp pink sparkle (brand primary)
    background: radial-gradient(
      circle,
      rgba(184, 134, 154, 0.65) 0%,
      rgba(184, 134, 154, 0.3) 50%,
      transparent 100%
    );

    // Dark mode: hidden
    html[data-theme='dark'] &,
    [data-theme='dark'] & {
      display: none !important;
    }
  }

  @keyframes sparkle-twinkle {
    0%,
    70%,
    100% {
      opacity: 0;
      transform: scale(0.5);
    }
    15%,
    35% {
      opacity: 1;
      transform: scale(1.2);
    }
    50% {
      opacity: 0.7;
      transform: scale(1);
    }
  }

  /* ==========================================================================
   INTENSITY VARIATIONS
   ========================================================================== */

  .dynamic-background--subtle {
    .wave-layer {
      opacity: 0.5;
    }
    /* .particle {
      opacity: 0.6;
    } */
    .color-sparkle {
      opacity: 0.7;
    }
    .contrast-element {
      opacity: 0.6;
    }
    .glitch-overlay {
      opacity: 0.4;
    }
  }

  .dynamic-background--medium {
    .wave-layer {
      opacity: 0.8;
    }
    /* .particle {
      opacity: 0.9;
    } */
    .color-sparkle {
      opacity: 1;
    }
    .contrast-element {
      opacity: 0.9;
    }
    .glitch-overlay {
      opacity: 0.6;
    }
  }

  .dynamic-background--high {
    .wave-layer {
      opacity: 1;
    }
    /* .particle {
      opacity: 1;
    } */
    .color-sparkle {
      opacity: 1;
    }
    .contrast-element {
      opacity: 1;
    }
    .glitch-overlay {
      opacity: 0.8;
    }
  }

  /* ==========================================================================
   ACCESSIBILITY & PERFORMANCE
   ========================================================================== */

  @media (prefers-reduced-motion: reduce) {
    .dynamic-background * {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }

  @media (max-device-memory: 1GB) {
    .dynamic-background {
      .wave-layer,
      .glitch-overlay,
      .color-sparkle,
      .contrast-element,
      .glitch-line {
        display: none;
      }
    }
  }

  /* Mobile optimizations */
  @media (max-width: 768px) {
    .dynamic-background {
      .wave-layer {
        opacity: 0.7;
      }
      /* .particle {
        opacity: 0.8;
        transform: scale(0.8);
      } */
      .color-sparkle {
        opacity: 0.8;
        transform: scale(0.8);
      }
      .contrast-element {
        opacity: 0.7;
        transform: scale(0.9);
      }
    }
  }
</style>

<script>
  // Add dynamic randomization for glitch lines
  function randomizeGlitchLines() {
    const glitchLines = document.querySelectorAll('.glitch-line');

    glitchLines.forEach((line, index) => {
      const randomizeAnimation = () => {
        // Random delay between 1-8 seconds
        const delay = Math.random() * 7 + 1;

        // Random duration between 0.25-1 second
        const duration = Math.random() * 0.75 + 0.25;

        // Random position
        const top = Math.random() * 90 + 5; // 5-95%
        const left = Math.random() * 100; // 0-100% - randomized horizontal starting position
        const width = Math.random() * 50 + 20; // 20-70%

        // Apply styles
        (line as HTMLElement).style.animationDelay = `${delay}s`;
        (line as HTMLElement).style.animationDuration = `${delay + duration}s`;

        // Custom keyframe for this specific line
        const keyframeName = `glitch-line-dynamic-${index}`;
        const keyframes = `
          @keyframes ${keyframeName} {
            0%, ${(delay / (delay + duration)) * 100}% { 
              opacity: 0; 
            }
            ${((delay + 0.01) / (delay + duration)) * 100}% { 
              opacity: 1;
              top: ${top}%;
              left: ${left}%;
              width: ${width}%;
            }
            ${((delay + duration - 0.01) / (delay + duration)) * 100}% { 
              opacity: 1;
              top: ${top}%;
              left: ${left}%;
              width: ${width}%;
            }
            ${((delay + duration) / (delay + duration)) * 100}%, 100% { 
              opacity: 0; 
            }
          }
        `;

        // Inject keyframe
        const styleSheet = document.createElement('style');
        styleSheet.textContent = keyframes;
        document.head.appendChild(styleSheet);

        // Apply animation
        (line as HTMLElement).style.animation =
          `${keyframeName} ${delay + duration}s steps(1) infinite`;

        // Clean up old style tags periodically
        setTimeout(
          () => {
            if (styleSheet.parentNode) {
              styleSheet.parentNode.removeChild(styleSheet);
            }
          },
          (delay + duration) * 1000
        );
      };

      // Initial randomization
      randomizeAnimation();

      // Re-randomize periodically
      setInterval(randomizeAnimation, (Math.random() * 8 + 5) * 1000);
    });
  }

  // Initialize on DOM load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', randomizeGlitchLines);
  } else {
    randomizeGlitchLines();
  }
</script>
