---
// PortfolioFilter.astro - Accessible filter bar for portfolio items
export interface Props {
  availableMediaTypes?: string[];
  availableTags?: string[];
  class?: string;
}

const {
  availableMediaTypes = [
    'code',
    'video',
    'blog',
    'audio',
    'image',
    'design',
    'presentation',
  ],
  availableTags = [],
  class: className = '',
} = Astro.props;

// Generate unique IDs for form controls
const mediaTypeFieldsetId = 'portfolio-media-types';
const tagFieldsetId = 'portfolio-tags';
const sortFieldId = 'portfolio-sort';
---

<div class={`portfolio-filter ${className}`} id="portfolio-filter">
  <form
    class="portfolio-filter__form"
    role="search"
    aria-label="Filter portfolio items"
  >
    <!-- Filter Header -->
    <header class="portfolio-filter__header">
      <h2 class="portfolio-filter__title">Filter & Sort</h2>
      <button
        type="button"
        class="portfolio-filter__reset"
        id="reset-filters"
        aria-label="Reset all filters"
      >
        Reset
      </button>
    </header>

    <!-- Filter Controls Container -->
    <div class="portfolio-filter__controls">
      <!-- Search Input -->
      <div class="portfolio-filter__section portfolio-filter__section--search">
        <label for="portfolio-search" class="portfolio-filter__label">
          Search Projects
        </label>
        <input
          type="search"
          id="portfolio-search"
          class="portfolio-filter__search"
          placeholder="Search by title, description, or technology..."
          aria-describedby="search-help"
        />
        <p id="search-help" class="portfolio-filter__help">
          Start typing to filter projects in real-time
        </p>
      </div>

      <!-- Media Type Filter -->
      <fieldset
        class="portfolio-filter__section portfolio-filter__section--media"
        id={mediaTypeFieldsetId}
      >
        <legend class="portfolio-filter__legend">Media Type</legend>
        <div
          class="portfolio-filter__options"
          role="group"
          aria-labelledby="media-type-legend"
        >
          <label class="portfolio-filter__option">
            <input
              type="radio"
              name="mediaType"
              value="all"
              class="portfolio-filter__radio"
              checked
              aria-describedby="media-all-desc"
            />
            <span class="portfolio-filter__option-label">All</span>
          </label>

          {
            availableMediaTypes.map((mediaType) => (
              <label class="portfolio-filter__option">
                <input
                  type="radio"
                  name="mediaType"
                  value={mediaType}
                  class="portfolio-filter__radio"
                  aria-describedby={`media-${mediaType}-desc`}
                />
                <span class="portfolio-filter__option-label">
                  {mediaType.charAt(0).toUpperCase() + mediaType.slice(1)}
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <!-- Status Filter -->
      <fieldset
        class="portfolio-filter__section portfolio-filter__section--status"
      >
        <legend class="portfolio-filter__legend">Project Status</legend>
        <div class="portfolio-filter__options" role="group">
          <label class="portfolio-filter__option">
            <input
              type="radio"
              name="status"
              value="all"
              class="portfolio-filter__radio"
              checked
            />
            <span class="portfolio-filter__option-label">All Projects</span>
          </label>

          <label class="portfolio-filter__option">
            <input
              type="radio"
              name="status"
              value="featured"
              class="portfolio-filter__radio"
            />
            <span class="portfolio-filter__option-label">Featured</span>
          </label>

          <label class="portfolio-filter__option">
            <input
              type="radio"
              name="status"
              value="completed"
              class="portfolio-filter__radio"
            />
            <span class="portfolio-filter__option-label">Completed</span>
          </label>
        </div>
      </fieldset>

      <!-- Sort Options -->
      <div class="portfolio-filter__section portfolio-filter__section--sort">
        <label for={sortFieldId} class="portfolio-filter__legend">
          Sort By
        </label>
        <select
          id={sortFieldId}
          name="sort"
          class="portfolio-filter__select"
          aria-describedby="sort-help"
        >
          <option value="priority">Priority (Featured first)</option>
          <option value="newest">Newest First</option>
          <option value="oldest">Oldest First</option>
          <option value="title">Title (A-Z)</option>
          <option value="mediaType">Media Type</option>
        </select>
        <p id="sort-help" class="portfolio-filter__help">
          Choose how to order the portfolio items
        </p>
      </div>

      <!-- Tag Cloud (if tags available) -->
      {
        availableTags.length > 0 && (
          <fieldset
            class="portfolio-filter__section portfolio-filter__section--tags"
            id={tagFieldsetId}
          >
            <legend class="portfolio-filter__legend">Popular Tags</legend>
            <div
              class="portfolio-filter__tag-cloud"
              role="group"
              aria-labelledby="tag-legend"
            >
              {availableTags.slice(0, 8).map((tag) => (
                <label class="portfolio-filter__tag">
                  <input
                    type="checkbox"
                    name="tags"
                    value={tag}
                    class="portfolio-filter__tag-input"
                    aria-describedby={`tag-${tag.replace(/\s+/g, '-')}-desc`}
                  />
                  <span class="portfolio-filter__tag-label">#{tag}</span>
                </label>
              ))}
            </div>
            {availableTags.length > 8 && (
              <details
                class="portfolio-filter__tag-more"
                aria-label="Show more tags"
              >
                <summary class="portfolio-filter__tag-toggle">
                  Show{' '}
                  {availableTags.length > 8
                    ? `${availableTags.length - 8} more tags`
                    : 'all tags'}
                </summary>
                <div class="portfolio-filter__tag-cloud">
                  {availableTags.slice(8).map((tag) => (
                    <label class="portfolio-filter__tag">
                      <input
                        type="checkbox"
                        name="tags"
                        value={tag}
                        class="portfolio-filter__tag-input"
                      />
                      <span class="portfolio-filter__tag-label">#{tag}</span>
                    </label>
                  ))}
                </div>
              </details>
            )}
          </fieldset>
        )
      }
    </div>

    <!-- Results Summary -->
    <div
      class="portfolio-filter__results"
      aria-live="polite"
      aria-atomic="true"
    >
      <span id="results-count" class="portfolio-filter__results-text">
        Loading portfolio items...
      </span>
    </div>
  </form>
</div>

<style>
  /* Filter Container */
  .portfolio-filter {
    background: var(--color-glass-bg-light);
    backdrop-filter: blur(var(--glass-blur-light));
    border: 1px solid var(--color-glass-border-light);
    border-radius: var(--glass-radius);
    box-shadow: var(--glass-shadow-light);
    padding: var(--spacing-lg);
    margin-bottom: var(--spacing-xl);
  }

  /* Horizontal Layout for Filter */
  .portfolio-filter--horizontal {
    position: static;
    z-index: 10;
  }

  /* Form Layout */
  .portfolio-filter__form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  /* Header */
  .portfolio-filter__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--color-glass-border-light);
    padding-bottom: var(--spacing-sm);
  }

  .portfolio-filter__title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
  }

  .portfolio-filter__reset {
    padding: 0.5rem 1rem;
    background: var(--color-glass-bg-medium);
    border: 1px solid var(--color-glass-border-medium);
    border-radius: calc(var(--glass-radius) * 0.5);
    color: var(--color-text-primary);
    font-weight: 600;
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .portfolio-filter__reset:hover {
    background: var(--color-glass-bg-heavy);
    border-color: var(--color-glass-border-heavy);
    transform: translateY(-1px);
  }

  .portfolio-filter__reset:focus {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
  }

  /* Controls Container - Horizontal Layout */
  .portfolio-filter__controls {
    display: grid;
    grid-template-columns: 1fr auto auto auto;
    gap: var(--spacing-lg);
    align-items: start;
  }

  /* Sections */
  .portfolio-filter__section {
    border: none;
    padding: 0;
    margin: 0;
  }

  .portfolio-filter__section--search {
    min-width: 250px;
  }

  .portfolio-filter__section--tags {
    grid-column: 1 / -1;
    margin-top: var(--spacing-sm);
    padding-top: var(--spacing-sm);
    border-top: 1px solid var(--color-glass-border-light);
  }

  .portfolio-filter__legend,
  .portfolio-filter__label {
    display: block;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-xs);
    font-size: 0.875rem;
  }

  .portfolio-filter__legend {
    border: none;
    padding: 0;
  }

  /* Search Input */
  .portfolio-filter__search {
    width: 100%;
    padding: 0.625rem 0.875rem;
    background: var(--color-glass-bg-light);
    border: 1px solid var(--color-glass-border-medium);
    border-radius: calc(var(--glass-radius) * 0.5);
    color: var(--color-text-primary);
    font-size: 0.875rem;
    transition: all 0.2s ease;
  }

  .portfolio-filter__search:focus {
    outline: none;
    border-color: var(--color-accent-primary);
    box-shadow: 0 0 0 2px rgba(var(--color-accent-primary-rgb), 0.2);
    background: var(--color-glass-bg-medium);
  }

  .portfolio-filter__search::placeholder {
    color: var(--color-text-tertiary);
  }

  /* Options - Horizontal Layout */
  .portfolio-filter__options {
    display: flex;
    gap: var(--spacing-xs);
    flex-wrap: wrap;
  }

  .portfolio-filter__option {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.625rem;
    border-radius: calc(var(--glass-radius) * 0.25);
    cursor: pointer;
    transition: all 0.2s ease;
    position: relative;
    background: var(--color-glass-bg-light);
    border: 1px solid var(--color-glass-border-light);
    white-space: nowrap;
  }

  .portfolio-filter__option:hover {
    background: var(--color-glass-bg-medium);
    border-color: var(--color-glass-border-medium);
  }

  .portfolio-filter__radio {
    width: 0.875rem;
    height: 0.875rem;
    accent-color: var(--color-accent-primary);
    cursor: pointer;
  }

  .portfolio-filter__option-label {
    color: var(--color-text-secondary);
    font-weight: 500;
    font-size: 0.875rem;
  }

  .portfolio-filter__option:has(.portfolio-filter__radio:checked) {
    background: var(--color-accent-primary);
    border-color: var(--color-accent-primary);
  }

  .portfolio-filter__option:has(.portfolio-filter__radio:checked)
    .portfolio-filter__option-label {
    color: white;
    font-weight: 600;
  }

  /* Select */
  .portfolio-filter__select {
    min-width: 180px;
    padding: 0.625rem 0.875rem;
    background: var(--color-glass-bg-light);
    border: 1px solid var(--color-glass-border-medium);
    border-radius: calc(var(--glass-radius) * 0.5);
    color: var(--color-text-primary);
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .portfolio-filter__select:focus {
    outline: none;
    border-color: var(--color-accent-primary);
    box-shadow: 0 0 0 2px rgba(var(--color-accent-primary-rgb), 0.2);
    background: var(--color-glass-bg-medium);
  }

  /* Tag Cloud */
  .portfolio-filter__tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .portfolio-filter__tag {
    position: relative;
    cursor: pointer;
  }

  .portfolio-filter__tag-input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .portfolio-filter__tag-label {
    display: inline-block;
    padding: 0.25rem 0.5rem;
    background: var(--color-glass-bg-light);
    border: 1px solid var(--color-glass-border-medium);
    border-radius: calc(var(--glass-radius) * 0.5);
    color: var(--color-text-secondary);
    font-size: 0.75rem;
    font-weight: 500;
    transition: all 0.2s ease;
    user-select: none;
  }

  .portfolio-filter__tag:hover .portfolio-filter__tag-label {
    background: var(--color-glass-bg-medium);
    border-color: var(--color-glass-border-heavy);
  }

  .portfolio-filter__tag-input:checked + .portfolio-filter__tag-label {
    background: var(--color-accent-primary);
    border-color: var(--color-accent-primary);
    color: white;
    font-weight: 600;
    transform: translateY(-1px);
  }

  .portfolio-filter__tag-input:focus + .portfolio-filter__tag-label {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
  }

  /* Tag More */
  .portfolio-filter__tag-more {
    margin-top: var(--spacing-xs);
  }

  .portfolio-filter__tag-toggle {
    color: var(--color-text-secondary);
    cursor: pointer;
    font-size: 0.75rem;
    font-weight: 600;
    list-style: none;
    padding: 0.25rem 0.5rem;
    border-radius: calc(var(--glass-radius) * 0.25);
    transition: all 0.2s ease;
    background: var(--color-glass-bg-light);
    border: 1px solid var(--color-glass-border-light);
  }

  .portfolio-filter__tag-toggle:hover {
    background: var(--color-glass-bg-medium);
    color: var(--color-text-primary);
  }

  .portfolio-filter__tag-toggle::marker {
    display: none;
  }

  .portfolio-filter__tag-toggle::before {
    content: '▶';
    margin-right: 0.375rem;
    transition: transform 0.2s ease;
    font-size: 0.625rem;
  }

  .portfolio-filter__tag-more[open] .portfolio-filter__tag-toggle::before {
    transform: rotate(90deg);
  }

  /* Results Summary */
  .portfolio-filter__results {
    padding: var(--spacing-sm);
    background: var(--color-glass-bg-medium);
    border: 1px solid var(--color-glass-border-medium);
    border-radius: calc(var(--glass-radius) * 0.5);
    text-align: center;
  }

  .portfolio-filter__results-text {
    font-weight: 600;
    color: var(--color-text-primary);
    font-size: 0.875rem;
  }

  /* Help Text */
  .portfolio-filter__help {
    font-size: 0.625rem;
    color: var(--color-text-tertiary);
    margin: 0.25rem 0 0 0;
    line-height: 1.4;
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .portfolio-filter__controls {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }

    .portfolio-filter__section--search {
      min-width: auto;
    }

    .portfolio-filter__section--tags {
      grid-column: 1;
      margin-top: var(--spacing-sm);
    }
  }

  @media (max-width: 768px) {
    .portfolio-filter {
      padding: var(--spacing-md);
    }

    .portfolio-filter__header {
      flex-direction: column;
      gap: var(--spacing-sm);
      align-items: stretch;
    }

    .portfolio-filter__controls {
      gap: var(--spacing-sm);
    }

    .portfolio-filter__options {
      justify-content: center;
    }

    .portfolio-filter__tag-cloud {
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .portfolio-filter__form {
      gap: var(--spacing-sm);
    }

    .portfolio-filter__options {
      flex-direction: column;
      align-items: stretch;
    }

    .portfolio-filter__option {
      justify-content: center;
    }
  }

  /* High Contrast Mode */
  @media (prefers-contrast: high) {
    .portfolio-filter {
      border-width: 2px;
    }

    .portfolio-filter__radio,
    .portfolio-filter__tag-input:checked + .portfolio-filter__tag-label {
      outline: 2px solid currentColor;
      outline-offset: 2px;
    }
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .portfolio-filter__reset,
    .portfolio-filter__option,
    .portfolio-filter__tag-label,
    .portfolio-filter__search,
    .portfolio-filter__select {
      transition: none;
    }

    .portfolio-filter__tag-input:checked + .portfolio-filter__tag-label {
      transform: none;
    }
  }

  /* Print Styles */
  @media print {
    .portfolio-filter {
      display: none;
    }
  }
</style>

<script is:inline>
  // Portfolio Filter JavaScript
  class PortfolioFilter extends HTMLElement {
    constructor() {
      super();
      this.initializeFilter();
    }

    initializeFilter() {
      const form = this.querySelector('.portfolio-filter__form');
      const resetButton = this.querySelector('.portfolio-filter__reset');
      const searchInput = this.querySelector('.portfolio-filter__search');
      const resultsCount = this.querySelector('#results-count');

      // Add event listeners
      form?.addEventListener('input', this.handleFilterChange.bind(this));
      form?.addEventListener('change', this.handleFilterChange.bind(this));
      resetButton?.addEventListener('click', this.resetFilters.bind(this));
      searchInput?.addEventListener(
        'input',
        this.debounce(this.handleSearch.bind(this), 300)
      );

      // Initialize counts
      this.updateCounts();

      // Announce filter readiness to screen readers
      if (resultsCount) {
        resultsCount.textContent =
          'Portfolio filter ready. Use the controls above to filter projects.';
      }
    }

    handleFilterChange(event) {
      // Filter logic will be handled by the portfolio grid component
      // This dispatches custom events for the grid to listen to
      const filterData = this.getFilterData();

      this.dispatchEvent(
        new CustomEvent('portfolio-filter-change', {
          detail: filterData,
          bubbles: true,
        })
      );

      this.updateResults(filterData);
    }

    handleSearch(event) {
      const target = event.target;
      const searchTerm = target.value.trim().toLowerCase();

      this.dispatchEvent(
        new CustomEvent('portfolio-search', {
          detail: { searchTerm },
          bubbles: true,
        })
      );
    }

    getFilterData() {
      const form = this.querySelector('.portfolio-filter__form');
      if (!form) return {};

      const formData = new FormData(form);

      return {
        mediaType: formData.get('mediaType') || 'all',
        status: formData.get('status') || 'all',
        sort: formData.get('sort') || 'priority',
        tags: formData.getAll('tags'),
        search: formData.get('search') || '',
      };
    }

    resetFilters() {
      const form = this.querySelector('.portfolio-filter__form');

      // Reset form
      form?.reset();

      // Reset search
      const searchInput = this.querySelector('.portfolio-filter__search');
      if (searchInput) {
        searchInput.value = '';
      }

      // Dispatch reset event
      this.dispatchEvent(
        new CustomEvent('portfolio-filter-reset', {
          bubbles: true,
        })
      );

      // Update counts
      this.updateCounts();

      // Announce reset to screen readers
      const resultsCount = this.querySelector('#results-count');
      if (resultsCount) {
        resultsCount.textContent =
          'Filters reset. Showing all portfolio items.';
      }
    }

    updateCounts() {
      // This would be called by the portfolio grid to update filter counts
      // For now, we'll set placeholder values
      const countElements = this.querySelectorAll(
        '.portfolio-filter__option-count'
      );
      countElements.forEach((el) => {
        if (el.textContent && !el.textContent.trim()) {
          el.textContent = '0';
        }
      });
    }

    updateResults(filterData) {
      const resultsCount = this.querySelector('#results-count');
      if (resultsCount) {
        // This will be updated by the portfolio grid component
        resultsCount.textContent = 'Filtering portfolio items...';
      }
    }

    debounce(func, wait) {
      let timeout;
      return function executedFunction(...args) {
        const later = () => {
          clearTimeout(timeout);
          func(...args);
        };
        clearTimeout(timeout);
        timeout = setTimeout(later, wait);
      };
    }
  }

  // Register the custom element
  customElements.define('portfolio-filter', PortfolioFilter);
</script>
