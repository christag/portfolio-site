---
// PortfolioFilter.astro - Horizontal filter bar for portfolio items
export interface Props {
  availableMediaTypes?: string[];
  availableTags?: string[];
  class?: string;
}

const {
  availableMediaTypes = [
    'code',
    'video',
    'blog',
    'audio',
    'image',
    'design',
    'presentation',
  ],
  availableTags = [],
  class: className = '',
} = Astro.props;

// Generate unique IDs for form controls
const mediaTypeFieldsetId = 'portfolio-media-types';
const tagFieldsetId = 'portfolio-tags';
const sortFieldId = 'portfolio-sort';
---

<div class={`portfolio-filter ${className}`} id="portfolio-filter">
  <form
    class="portfolio-filter__form"
    role="search"
    aria-label="Filter portfolio items"
  >
    <!-- Horizontal Filter Layout -->
    <div class="portfolio-filter__horizontal">
      <!-- Media Type Filter -->
      <div class="portfolio-filter__section">
        <div class="portfolio-filter__dropdown">
          <button
            type="button"
            class="portfolio-filter__dropdown-toggle"
            aria-expanded="false"
            aria-haspopup="true"
            data-dropdown="media-types"
          >
            <span class="portfolio-filter__dropdown-label">Media Type</span>
            <span class="portfolio-filter__dropdown-arrow">▼</span>
          </button>
          <div
            class="portfolio-filter__dropdown-content"
            data-dropdown-content="media-types"
          >
            <fieldset
              class="portfolio-filter__fieldset"
              id={mediaTypeFieldsetId}
            >
              <legend class="portfolio-filter__legend sr-only"
                >Media Type</legend
              >
              <div class="portfolio-filter__options">
                <label class="portfolio-filter__option">
                  <input
                    type="checkbox"
                    name="mediaType"
                    value="all"
                    class="portfolio-filter__checkbox"
                    checked
                    data-select-all="media-types"
                  />
                  <span class="portfolio-filter__option-label">All</span>
                </label>

                {
                  availableMediaTypes.map((mediaType) => (
                    <label class="portfolio-filter__option">
                      <input
                        type="checkbox"
                        name="mediaType"
                        value={mediaType}
                        class="portfolio-filter__checkbox"
                      />
                      <span class="portfolio-filter__option-label">
                        {mediaType.charAt(0).toUpperCase() + mediaType.slice(1)}
                      </span>
                    </label>
                  ))
                }
              </div>
            </fieldset>
          </div>
        </div>
      </div>

      <!-- Status Filter -->
      <div class="portfolio-filter__section">
        <div class="portfolio-filter__dropdown">
          <button
            type="button"
            class="portfolio-filter__dropdown-toggle"
            aria-expanded="false"
            aria-haspopup="true"
            data-dropdown="status"
          >
            <span class="portfolio-filter__dropdown-label">Status</span>
            <span class="portfolio-filter__dropdown-arrow">▼</span>
          </button>
          <div
            class="portfolio-filter__dropdown-content"
            data-dropdown-content="status"
          >
            <fieldset class="portfolio-filter__fieldset">
              <legend class="portfolio-filter__legend sr-only"
                >Project Status</legend
              >
              <div class="portfolio-filter__options">
                <label class="portfolio-filter__option">
                  <input
                    type="checkbox"
                    name="status"
                    value="all"
                    class="portfolio-filter__checkbox"
                    checked
                    data-select-all="status"
                  />
                  <span class="portfolio-filter__option-label"
                    >All Projects</span
                  >
                </label>

                <label class="portfolio-filter__option">
                  <input
                    type="checkbox"
                    name="status"
                    value="featured"
                    class="portfolio-filter__checkbox"
                  />
                  <span class="portfolio-filter__option-label">Featured</span>
                </label>

                <label class="portfolio-filter__option">
                  <input
                    type="checkbox"
                    name="status"
                    value="completed"
                    class="portfolio-filter__checkbox"
                  />
                  <span class="portfolio-filter__option-label">Completed</span>
                </label>
              </div>
            </fieldset>
          </div>
        </div>
      </div>

      <!-- Tags Filter (if available) -->
      {
        availableTags.length > 0 && (
          <div class="portfolio-filter__section">
            <div class="portfolio-filter__dropdown">
              <button
                type="button"
                class="portfolio-filter__dropdown-toggle"
                aria-expanded="false"
                aria-haspopup="true"
                data-dropdown="tags"
              >
                <span class="portfolio-filter__dropdown-label">Tags</span>
                <span class="portfolio-filter__dropdown-arrow">▼</span>
              </button>
              <div
                class="portfolio-filter__dropdown-content"
                data-dropdown-content="tags"
              >
                <fieldset class="portfolio-filter__fieldset" id={tagFieldsetId}>
                  <legend class="portfolio-filter__legend sr-only">
                    Popular Tags
                  </legend>
                  <div class="portfolio-filter__options portfolio-filter__options--tags">
                    {availableTags.slice(0, 8).map((tag) => (
                      <label class="portfolio-filter__option">
                        <input
                          type="checkbox"
                          name="tags"
                          value={tag}
                          class="portfolio-filter__checkbox"
                        />
                        <span class="portfolio-filter__option-label">
                          #{tag}
                        </span>
                      </label>
                    ))}
                  </div>
                </fieldset>
              </div>
            </div>
          </div>
        )
      }

      <!-- Sort Options -->
      <div class="portfolio-filter__section">
        <div class="portfolio-filter__dropdown">
          <button
            type="button"
            class="portfolio-filter__dropdown-toggle"
            aria-expanded="false"
            aria-haspopup="true"
            data-dropdown="sort"
          >
            <span class="portfolio-filter__dropdown-label">Sort By</span>
            <span class="portfolio-filter__dropdown-arrow">▼</span>
          </button>
          <div
            class="portfolio-filter__dropdown-content"
            data-dropdown-content="sort"
          >
            <div class="portfolio-filter__sort-wrapper">
              <select
                id={sortFieldId}
                name="sort"
                class="portfolio-filter__select"
              >
                <option value="priority">Priority (Featured first)</option>
                <option value="newest">Newest First</option>
                <option value="oldest">Oldest First</option>
                <option value="title">Title (A-Z)</option>
                <option value="mediaType">Media Type</option>
              </select>
            </div>
          </div>
        </div>
      </div>

      <!-- Search Input -->
      <div class="portfolio-filter__section portfolio-filter__section--search">
        <input
          type="search"
          id="portfolio-search"
          class="portfolio-filter__search"
          placeholder="Search projects..."
        />
      </div>

      <!-- Reset Button -->
      <div class="portfolio-filter__section">
        <button
          type="button"
          class="portfolio-filter__reset"
          id="reset-filters"
          aria-label="Reset all filters"
        >
          Reset
        </button>
      </div>
    </div>

    <!-- Results Summary -->
    <div
      class="portfolio-filter__results"
      aria-live="polite"
      aria-atomic="true"
    >
      <span id="results-count" class="portfolio-filter__results-text">
        Loading portfolio items...
      </span>
    </div>
  </form>
</div>

<style>
  /* Screen reader only class */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Filter Container */
  .portfolio-filter {
    background: var(--glass-bg-primary);
    backdrop-filter: blur(var(--glass-blur-navigation));
    border: 1px solid var(--glass-border-light);
    border-radius: var(--glass-radius);
    padding: var(--space-lg);
    margin-bottom: var(--space-xl);
    position: sticky;
    top: var(--space-lg);
    z-index: 10;
  }

  /* Horizontal Layout */
  .portfolio-filter__horizontal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    align-items: center;
    margin-bottom: var(--space-md);
  }

  .portfolio-filter__section {
    position: relative;
  }

  .portfolio-filter__section--search {
    flex: 1;
    min-width: 200px;
  }

  /* Dropdown Styling */
  .portfolio-filter__dropdown {
    position: relative;
  }

  .portfolio-filter__dropdown-toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    background: var(--glass-bg-secondary);
    border: 1px solid var(--glass-border-medium);
    border-radius: calc(var(--glass-radius) * 0.5);
    color: var(--color-text-primary);
    font-weight: 600;
    font-size: 0.875rem;
    cursor: pointer;
    transition: all var(--transition-normal);
    white-space: nowrap;
  }

  .portfolio-filter__dropdown-toggle:hover {
    background: var(--glass-bg-tertiary);
    border-color: var(--color-accent-primary);
  }

  .portfolio-filter__dropdown-toggle[aria-expanded='true'] {
    background: var(--glass-bg-tertiary);
    border-color: var(--color-accent-primary);
  }

  .portfolio-filter__dropdown-toggle[aria-expanded='true']
    .portfolio-filter__dropdown-arrow {
    transform: rotate(180deg);
  }

  .portfolio-filter__dropdown-arrow {
    font-size: 0.75rem;
    transition: transform var(--transition-normal);
  }

  .portfolio-filter__dropdown-content {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 200px;
    background: var(--glass-bg-primary);
    backdrop-filter: blur(var(--glass-blur-container));
    border: 1px solid var(--glass-border-light);
    border-radius: calc(var(--glass-radius) * 0.5);
    box-shadow: 0 8px 32px var(--glass-shadow-medium);
    z-index: 100;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all var(--transition-normal);
    margin-top: 0.5rem;
  }

  .portfolio-filter__dropdown-content.show {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .portfolio-filter__fieldset {
    border: none;
    padding: var(--space-sm);
    margin: 0;
  }

  /* Options */
  .portfolio-filter__options {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .portfolio-filter__options--tags {
    max-height: 200px;
    overflow-y: auto;
  }

  .portfolio-filter__option {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem;
    border-radius: calc(var(--glass-radius) * 0.25);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .portfolio-filter__option:hover {
    background: var(--glass-bg-secondary);
  }

  .portfolio-filter__checkbox {
    width: 1rem;
    height: 1rem;
    accent-color: var(--color-accent-primary);
    cursor: pointer;
  }

  .portfolio-filter__option-label {
    color: var(--color-text-secondary);
    font-weight: 500;
    font-size: 0.875rem;
  }

  .portfolio-filter__option:has(.portfolio-filter__checkbox:checked)
    .portfolio-filter__option-label {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  /* Sort Select */
  .portfolio-filter__sort-wrapper {
    padding: var(--space-sm);
  }

  .portfolio-filter__select {
    width: 100%;
    padding: 0.75rem 1rem;
    background: var(--glass-bg-secondary);
    border: 1px solid var(--glass-border-medium);
    border-radius: calc(var(--glass-radius) * 0.5);
    color: var(--color-text-primary);
    font-size: 0.875rem;
    cursor: pointer;
    transition: all var(--transition-normal);
    min-width: 200px;
  }

  .portfolio-filter__select:focus {
    outline: none;
    border-color: var(--color-accent-primary);
    box-shadow: 0 0 0 2px rgba(var(--color-accent-primary), 0.2);
  }

  /* Search Input */
  .portfolio-filter__search {
    width: 100%;
    padding: 0.75rem 1rem;
    background: var(--glass-bg-secondary);
    border: 1px solid var(--glass-border-medium);
    border-radius: calc(var(--glass-radius) * 0.5);
    color: var(--color-text-primary);
    font-size: 0.875rem;
    transition: all var(--transition-normal);
  }

  .portfolio-filter__search:focus {
    outline: none;
    border-color: var(--color-accent-primary);
    box-shadow: 0 0 0 2px rgba(var(--color-accent-primary), 0.2);
  }

  .portfolio-filter__search::placeholder {
    color: var(--color-text-tertiary);
  }

  /* Reset Button */
  .portfolio-filter__reset {
    padding: 0.75rem 1.5rem;
    background: var(--glass-bg-secondary);
    border: 1px solid var(--glass-border-medium);
    border-radius: calc(var(--glass-radius) * 0.5);
    color: var(--color-text-primary);
    font-weight: 600;
    font-size: 0.875rem;
    cursor: pointer;
    transition: all var(--transition-normal);
  }

  .portfolio-filter__reset:hover {
    background: var(--color-accent-primary);
    color: white;
    border-color: var(--color-accent-primary);
  }

  /* Results Summary */
  .portfolio-filter__results {
    padding: var(--space-sm);
    background: var(--glass-bg-secondary);
    border: 1px solid var(--glass-border-light);
    border-radius: calc(var(--glass-radius) * 0.5);
    text-align: center;
  }

  .portfolio-filter__results-text {
    font-weight: 600;
    color: var(--color-text-primary);
    font-size: 0.875rem;
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .portfolio-filter__horizontal {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-sm);
    }

    .portfolio-filter__section {
      width: 100%;
    }

    .portfolio-filter__dropdown-content {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      margin-top: 0.5rem;
      box-shadow: none;
      border: 1px solid var(--glass-border-light);
    }

    .portfolio-filter__dropdown-toggle {
      justify-content: space-between;
      width: 100%;
    }
  }

  @media (max-width: 768px) {
    .portfolio-filter {
      position: static;
      padding: var(--space-md);
    }

    .portfolio-filter__options--tags {
      max-height: 150px;
    }
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .portfolio-filter__dropdown-content,
    .portfolio-filter__dropdown-arrow,
    .portfolio-filter__option {
      transition: none;
    }
  }
</style>

<script is:inline>
  // Portfolio Filter JavaScript
  document.addEventListener('DOMContentLoaded', function () {
    const filterContainer = document.getElementById('portfolio-filter');
    if (!filterContainer) return;

    const form = filterContainer.querySelector('.portfolio-filter__form');
    const resetButton = filterContainer.querySelector(
      '.portfolio-filter__reset'
    );
    const searchInput = filterContainer.querySelector(
      '.portfolio-filter__search'
    );
    const resultsCount = filterContainer.querySelector('#results-count');

    // Dropdown functionality
    const dropdownToggles = filterContainer.querySelectorAll(
      '.portfolio-filter__dropdown-toggle'
    );

    dropdownToggles.forEach((toggle) => {
      toggle.addEventListener('click', function (e) {
        e.preventDefault();
        const dropdownId = this.getAttribute('data-dropdown');
        const content = filterContainer.querySelector(
          `[data-dropdown-content="${dropdownId}"]`
        );
        const isExpanded = this.getAttribute('aria-expanded') === 'true';

        // Close all other dropdowns
        dropdownToggles.forEach((otherToggle) => {
          if (otherToggle !== this) {
            otherToggle.setAttribute('aria-expanded', 'false');
            const otherContent = filterContainer.querySelector(
              `[data-dropdown-content="${otherToggle.getAttribute('data-dropdown')}"]`
            );
            if (otherContent) {
              otherContent.classList.remove('show');
            }
          }
        });

        // Toggle current dropdown
        this.setAttribute('aria-expanded', !isExpanded);
        if (content) {
          content.classList.toggle('show', !isExpanded);
        }
      });
    });

    // Close dropdowns when clicking outside
    document.addEventListener('click', function (e) {
      if (!filterContainer.contains(e.target)) {
        dropdownToggles.forEach((toggle) => {
          toggle.setAttribute('aria-expanded', 'false');
          const dropdownId = toggle.getAttribute('data-dropdown');
          const content = filterContainer.querySelector(
            `[data-dropdown-content="${dropdownId}"]`
          );
          if (content) {
            content.classList.remove('show');
          }
        });
      }
    });

    // Handle "Select All" checkboxes
    const selectAllCheckboxes =
      filterContainer.querySelectorAll('[data-select-all]');
    selectAllCheckboxes.forEach((selectAll) => {
      selectAll.addEventListener('change', function () {
        const group = this.getAttribute('data-select-all');
        const groupCheckboxes = filterContainer.querySelectorAll(
          `input[name="${group === 'media-types' ? 'mediaType' : 'status'}"]`
        );

        if (this.checked) {
          groupCheckboxes.forEach((checkbox) => {
            if (checkbox !== this) {
              checkbox.checked = false;
            }
          });
        }
      });
    });

    // Handle individual checkboxes
    const individualCheckboxes = filterContainer.querySelectorAll(
      'input[type="checkbox"]:not([data-select-all])'
    );
    individualCheckboxes.forEach((checkbox) => {
      checkbox.addEventListener('change', function () {
        const name = this.name;
        const selectAll = filterContainer.querySelector(
          `[data-select-all][name="${name}"]`
        );

        if (this.checked && selectAll) {
          selectAll.checked = false;
        }
      });
    });

    // Filter change handling
    form.addEventListener('input', handleFilterChange);
    form.addEventListener('change', handleFilterChange);
    resetButton.addEventListener('click', resetFilters);
    searchInput.addEventListener('input', debounce(handleSearch, 300));

    function handleFilterChange(event) {
      const filterData = getFilterData();

      // Dispatch custom event for portfolio grid
      document.dispatchEvent(
        new CustomEvent('portfolio-filter-change', {
          detail: filterData,
        })
      );
    }

    function handleSearch(event) {
      const searchTerm = event.target.value.trim().toLowerCase();

      document.dispatchEvent(
        new CustomEvent('portfolio-search', {
          detail: { searchTerm },
        })
      );
    }

    function getFilterData() {
      const formData = new FormData(form);

      return {
        mediaTypes: formData
          .getAll('mediaType')
          .filter((type) => type !== 'all'),
        statuses: formData
          .getAll('status')
          .filter((status) => status !== 'all'),
        tags: formData.getAll('tags'),
        sort: formData.get('sort') || 'priority',
        search: formData.get('search') || '',
      };
    }

    function resetFilters() {
      form.reset();

      // Reset all dropdowns
      dropdownToggles.forEach((toggle) => {
        toggle.setAttribute('aria-expanded', 'false');
        const dropdownId = toggle.getAttribute('data-dropdown');
        const content = filterContainer.querySelector(
          `[data-dropdown-content="${dropdownId}"]`
        );
        if (content) {
          content.classList.remove('show');
        }
      });

      // Check "All" options
      const allCheckboxes =
        filterContainer.querySelectorAll('[data-select-all]');
      allCheckboxes.forEach((checkbox) => {
        checkbox.checked = true;
      });

      document.dispatchEvent(new CustomEvent('portfolio-filter-reset'));

      if (resultsCount) {
        resultsCount.textContent =
          'Filters reset. Showing all portfolio items.';
      }
    }

    function debounce(func, wait) {
      let timeout;
      return function executedFunction(...args) {
        const later = () => {
          clearTimeout(timeout);
          func(...args);
        };
        clearTimeout(timeout);
        timeout = setTimeout(later, wait);
      };
    }

    // Handle sort dropdown separately since it contains a select
    const sortDropdown = filterContainer.querySelector(
      '[data-dropdown="sort"]'
    );
    if (sortDropdown) {
      const sortSelect = filterContainer.querySelector(
        '.portfolio-filter__select'
      );

      // Handle sort dropdown toggle
      sortDropdown.addEventListener('click', function (e) {
        e.preventDefault();
        const content = filterContainer.querySelector(
          '[data-dropdown-content="sort"]'
        );
        const isExpanded = this.getAttribute('aria-expanded') === 'true';

        // Close all other dropdowns
        dropdownToggles.forEach((otherToggle) => {
          if (otherToggle !== this) {
            otherToggle.setAttribute('aria-expanded', 'false');
            const otherContent = filterContainer.querySelector(
              `[data-dropdown-content="${otherToggle.getAttribute('data-dropdown')}"]`
            );
            if (otherContent) {
              otherContent.classList.remove('show');
            }
          }
        });

        // Toggle current dropdown
        this.setAttribute('aria-expanded', !isExpanded);
        if (content) {
          content.classList.toggle('show', !isExpanded);
        }
      });

      // Handle select change
      sortSelect?.addEventListener('change', function () {
        handleFilterChange({ target: this });
        // Close the dropdown after selection
        sortDropdown.setAttribute('aria-expanded', 'false');
        const content = filterContainer.querySelector(
          '[data-dropdown-content="sort"]'
        );
        if (content) {
          content.classList.remove('show');
        }
      });

      // Prevent dropdown from closing when clicking on select
      const sortContent = filterContainer.querySelector(
        '[data-dropdown-content="sort"]'
      );
      sortContent?.addEventListener('click', function (e) {
        e.stopPropagation();
      });
    }

    // Initialize
    if (resultsCount) {
      resultsCount.textContent =
        'Portfolio filter ready. Use the controls above to filter projects.';
    }
  });
</script>
