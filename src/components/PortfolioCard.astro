---
// PortfolioCard.astro - Dynamic media card for portfolio items
import type { Portfolio } from '../lib/strapi';
import LazyImage from './LazyImage.astro';

export interface Props {
  item: Portfolio;
  class?: string;
  variant?: 'standard' | 'featured' | 'compact';
}

const { item, class: className = '', variant = 'standard' } = Astro.props;

// Parse tags and technologies
const tags = item.tags ? item.tags.split(',').map((tag) => tag.trim()) : [];
const technologies = item.technologies
  ? item.technologies.split(',').map((tech) => tech.trim())
  : [];

// Get media type icon (using text labels instead of emojis)
const getMediaTypeLabel = (mediaType: string) => {
  switch (mediaType) {
    case 'code':
      return 'Code';
    case 'video':
      return 'Video';
    case 'blog':
      return 'Blog';
    case 'audio':
      return 'Audio';
    case 'image':
      return 'Image';
    case 'design':
      return 'Design';
    case 'presentation':
      return 'Presentation';
    default:
      return 'Project';
  }
};

// Generate card classes
const cardClasses = [
  'portfolio-card',
  `portfolio-card--${variant}`,
  item.featured ? 'portfolio-card--featured' : '',
  className,
]
  .filter(Boolean)
  .join(' ');

// Get image URL
const imageUrl =
  item.featuredImage?.data?.attributes?.url || item.featuredImage?.url;
const imageAlt =
  item.featuredImage?.data?.attributes?.alternativeText || item.title;

// Check if we have a valid image URL
const hasImage = imageUrl && imageUrl.trim() !== '';

// Check if we have a slug for the detail page
const hasDetailPage = item.slug && item.slug.trim() !== '';
---

<article class={cardClasses} data-media-type={item.mediaType}>
  {
    item.featured && (
      <div class="pin-indicator" aria-label="Featured project">
        <span class="pin-text">[ FEATURED ]</span>
      </div>
    )
  }

  <!-- Always visible preview content -->
  <div class="portfolio-preview">
    <header class="portfolio-header">
      <h3 class="portfolio-title">{item.title}</h3>
      {
        item.client && (
          <span class="portfolio-client">// {item.client.toUpperCase()}</span>
        )
      }
      <div class="portfolio-type-badge">
        <span class="type-label">{getMediaTypeLabel(item.mediaType)}</span>
      </div>
    </header>

    <p class="portfolio-description-preview">
      {
        item.description.length > 120
          ? item.description.substring(0, 120) + '...'
          : item.description
      }
    </p>

    <!-- Details Toggle Button -->
    <button
      class="details-toggle"
      aria-expanded="false"
      aria-label={`Toggle details for ${item.title}`}
    >
      <span class="toggle-text">Show Details</span>
      <span class="toggle-arrow">↓</span>
    </button>
  </div>

  <!-- Expandable content -->
  <div class="portfolio-expanded" aria-hidden="true">
    <div class="portfolio-content">
      {
        hasImage && (
          <div class="portfolio-media">
            <LazyImage
              src={imageUrl}
              alt={imageAlt}
              class="portfolio-image"
              aspectRatio="16/9"
              placeholder="skeleton"
              priority={item.featured}
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
            />
          </div>
        )
      }

      <p class="portfolio-description">{item.description}</p>

      {
        technologies.length > 0 && (
          <div class="portfolio-technologies">
            <h4 class="tech-title">[ TECHNOLOGIES ]</h4>
            <div class="tech-list">
              {technologies.slice(0, 6).map((tech) => (
                <span class="tech-tag">{tech}</span>
              ))}
              {technologies.length > 6 && (
                <span class="tech-more">+{technologies.length - 6} more</span>
              )}
            </div>
          </div>
        )
      }

      {
        tags.length > 0 && (
          <div class="portfolio-tags">
            {tags.slice(0, 4).map((tag) => (
              <span class="tag">#{tag}</span>
            ))}
            {tags.length > 4 && (
              <span class="tag-more">+{tags.length - 4} more</span>
            )}
          </div>
        )
      }
    </div>

    <footer class="portfolio-footer">
      <div class="portfolio-actions">
        {
          item.demoUrl && (
            <a
              href={item.demoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="portfolio-action portfolio-action--demo"
            >
              <span>LIVE DEMO</span>
              <span>↗</span>
            </a>
          )
        }
        {
          item.repositoryUrl && (
            <a
              href={item.repositoryUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="portfolio-action portfolio-action--repo"
            >
              <span>SOURCE</span>
              <span>↗</span>
            </a>
          )
        }
        {
          hasDetailPage && (
            <a
              href={`/portfolio/${item.slug}`}
              class="portfolio-action portfolio-action--detail"
            >
              <span>DETAILS</span>
              <span>→</span>
            </a>
          )
        }
      </div>
    </footer>
  </div>
</article>

<style>
  /* Base Card Styles - Matching ServiceCard */
  .portfolio-card {
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 24px;
    padding: 1.5rem;
    position: relative;
    overflow: hidden;
    cursor: pointer;
    min-height: 200px;
    height: auto;
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Dark theme glass styling */
  [data-theme='dark'] .portfolio-card {
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .portfolio-card.expanded {
    transform: translateY(-4px);
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15);
    border-color: var(--color-accent-primary);
    background: rgba(255, 255, 255, 0.25);
  }

  [data-theme='dark'] .portfolio-card.expanded {
    background: rgba(0, 0, 0, 0.25);
  }

  .portfolio-card:focus-within {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
  }

  /* Featured/Pinned styling */
  .portfolio-card--featured {
    border-color: var(--color-accent-primary);
    box-shadow: 0 0 20px rgba(184, 134, 154, 0.2);
  }

  .pin-indicator {
    position: absolute;
    top: -1px;
    right: -1px;
    background: var(--color-accent-primary);
    color: white;
    padding: 0.4rem 0.8rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    border-radius: 0 24px 0 12px;
    z-index: 10;
  }

  /* Always visible preview content */
  .portfolio-preview {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .portfolio-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .portfolio-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.3;
  }

  .portfolio-client {
    font-size: 0.75rem;
    color: var(--color-accent-primary);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .portfolio-type-badge {
    align-self: flex-start;
  }

  .type-label {
    display: inline-block;
    padding: 0.25rem 0.5rem;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .portfolio-description-preview {
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0;
    font-size: 0.9rem;
  }

  .details-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 12px;
    color: var(--color-text-primary);
    font-weight: 600;
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .details-toggle:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--color-accent-primary);
  }

  .toggle-arrow {
    transition: transform 0.3s ease;
  }

  .portfolio-card.expanded .toggle-arrow {
    transform: rotate(180deg);
  }

  /* Expandable content */
  .portfolio-expanded {
    display: none;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .portfolio-card.expanded .portfolio-expanded {
    display: block;
  }

  .portfolio-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .portfolio-media {
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 16/9;
  }

  .portfolio-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .portfolio-description {
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .portfolio-technologies {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .tech-title {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-accent-primary);
    margin: 0;
    letter-spacing: 0.05em;
  }

  .tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-tag,
  .tech-more {
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 6px;
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  .tech-more {
    background: rgba(255, 255, 255, 0.15);
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .portfolio-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .tag,
  .tag-more {
    font-size: 0.75rem;
    color: var(--color-text-tertiary);
    font-weight: 500;
  }

  .tag-more {
    color: var(--color-text-secondary);
    font-weight: 600;
  }

  .portfolio-footer {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .portfolio-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .portfolio-action {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 1rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 8px;
    transition: all 0.2s ease;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.05);
    color: var(--color-text-primary);
    min-width: 100px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .portfolio-action:hover {
    transform: translateY(-1px);
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--color-accent-primary);
  }

  .portfolio-action--demo:hover {
    background: var(--color-accent-primary);
    color: white;
    border-color: var(--color-accent-primary);
  }

  .portfolio-action--repo:hover {
    background: var(--color-accent-secondary);
    color: white;
    border-color: var(--color-accent-secondary);
  }

  /* Responsive Adjustments */
  @media (max-width: 768px) {
    .portfolio-card {
      min-height: auto;
    }

    .portfolio-card__info {
      padding: 1.5rem;
      gap: 1rem;
    }

    .portfolio-card__title {
      font-size: 1.125rem;
    }

    .portfolio-card__actions {
      gap: 0.5rem;
    }

    .portfolio-card__action {
      font-size: 0.75rem;
      padding: 0.375rem 0.625rem;
    }

    .portfolio-card__type-badge,
    .portfolio-card__featured-badge {
      top: 1rem;
      left: 1rem;
      right: 1rem;
    }
  }

  /* Print Styles */
  @media print {
    .portfolio-card {
      background: white !important;
      border: 1px solid #ddd !important;
      box-shadow: none !important;
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .portfolio-action {
      display: none;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .portfolio-card,
    .details-toggle,
    .toggle-arrow {
      transition: none;
    }

    .portfolio-card.expanded {
      transform: none;
    }
  }
</style>

<script>
  // Portfolio card expand/collapse functionality
  document.addEventListener('DOMContentLoaded', () => {
    const portfolioCards = document.querySelectorAll('.portfolio-card');

    portfolioCards.forEach((card) => {
      const toggleButton = card.querySelector('.details-toggle');
      const toggleText = toggleButton?.querySelector('.toggle-text');
      const toggleArrow = toggleButton?.querySelector('.toggle-arrow');

      toggleButton?.addEventListener('click', (e) => {
        e.stopPropagation();

        const isExpanded = card.classList.contains('expanded');
        const expandedContent = card.querySelector('.portfolio-expanded');

        if (!isExpanded) {
          // Expand
          card.classList.add('expanded');
          toggleButton.setAttribute('aria-expanded', 'true');
          expandedContent?.setAttribute('aria-hidden', 'false');

          if (toggleText) toggleText.textContent = 'Show Less';
          if (toggleArrow) toggleArrow.textContent = '↑';

          // Smooth scroll to show expanded content
          setTimeout(() => {
            expandedContent?.scrollIntoView({
              behavior: 'smooth',
              block: 'nearest',
            });
          }, 150);
        } else {
          // Collapse
          card.classList.remove('expanded');
          toggleButton.setAttribute('aria-expanded', 'false');
          expandedContent?.setAttribute('aria-hidden', 'true');

          if (toggleText) toggleText.textContent = 'Show Details';
          if (toggleArrow) toggleArrow.textContent = '↓';

          // Smooth scroll back to card top
          setTimeout(() => {
            card.scrollIntoView({
              behavior: 'smooth',
              block: 'nearest',
            });
          }, 150);
        }
      });
    });
  });
</script>
