---
// PortfolioCard.astro - Portfolio card matching service card structure
import type { Portfolio } from '../lib/strapi';

export interface Props {
  item: Portfolio;
  class?: string;
  variant?: 'standard' | 'featured' | 'compact';
}

const { item, class: className = '', variant = 'standard' } = Astro.props;

// Parse tags and technologies
const tags = item.tags ? item.tags.split(',').map((tag) => tag.trim()) : [];
const technologies = item.technologies
  ? item.technologies.split(',').map((tech) => tech.trim())
  : [];

// Generate card classes
const cardClasses = [
  'portfolio-card',
  `portfolio-card--${variant}`,
  item.featured ? 'portfolio-card--featured' : '',
  className,
]
  .filter(Boolean)
  .join(' ');

// Get image URL
const imageUrl =
  item.featuredImage?.data?.attributes?.url || item.featuredImage?.url;
const imageAlt =
  item.featuredImage?.data?.attributes?.alternativeText || item.title;
---

<article
  class={cardClasses}
  role="article"
  aria-labelledby={`portfolio-title-${item.id}`}
  data-media-type={item.mediaType}
>
  {
    item.featured && (
      <div class="portfolio-featured-indicator" aria-label="Featured project">
        <span class="featured-text">[ FEATURED ]</span>
      </div>
    )
  }

  <!-- Always visible preview content -->
  <div class="portfolio-preview">
    <!-- Media/Image Section -->
    <div class="portfolio-media">
      {
        imageUrl ? (
          <img
            src={imageUrl}
            alt={imageAlt}
            loading="lazy"
            class="portfolio-image"
          />
        ) : (
          <div class="portfolio-placeholder">
            <span class="portfolio-media-type">
              {item.mediaType.toUpperCase()}
            </span>
          </div>
        )
      }

      <!-- Media type badge -->
      <div class="portfolio-type-badge">
        <span class="portfolio-type-label">{item.mediaType}</span>
      </div>
    </div>

    <header class="portfolio-header">
      <h3 id={`portfolio-title-${item.id}`} class="portfolio-title">
        {item.title}
      </h3>
      {
        item.client && (
          <p class="portfolio-client">// {item.client.toUpperCase()}</p>
        )
      }
    </header>

    <!-- Details Toggle Button - Always Visible -->
    <button
      class="portfolio-details-toggle"
      aria-expanded="false"
      aria-label={`Toggle details for ${item.title}`}
    >
      <span class="toggle-text">Show Details</span>
      <span class="toggle-arrow">↓</span>
    </button>
  </div>

  <!-- Expandable content that appears on click -->
  <div class="portfolio-expanded" aria-hidden="true">
    <div class="portfolio-content">
      <p class="portfolio-description">{item.description}</p>

      <!-- Technologies -->
      {
        technologies.length > 0 && (
          <div class="portfolio-technologies">
            <h4 class="tech-title">[ TECH STACK ]</h4>
            <div class="tech-list">
              {technologies.slice(0, 6).map((tech) => (
                <span class="tech-tag">{tech}</span>
              ))}
              {technologies.length > 6 && (
                <span class="tech-more">+ {technologies.length - 6} more</span>
              )}
            </div>
          </div>
        )
      }

      <!-- Tags -->
      {
        tags.length > 0 && (
          <div class="portfolio-tags">
            <h4 class="tags-title">[ TAGS ]</h4>
            <div class="tags-list">
              {tags.slice(0, 4).map((tag) => (
                <span class="tag-item">#{tag}</span>
              ))}
              {tags.length > 4 && (
                <span class="tag-more">+{tags.length - 4}</span>
              )}
            </div>
          </div>
        )
      }
    </div>

    <footer class="portfolio-footer">
      <div class="portfolio-actions">
        {
          item.demoUrl && (
            <a
              href={item.demoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="portfolio-action portfolio-action--demo"
              aria-label={`View live demo of ${item.title}`}
            >
              <span class="action-text">LIVE DEMO</span>
              <span class="action-arrow">→</span>
            </a>
          )
        }
        {
          item.repositoryUrl && (
            <a
              href={item.repositoryUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="portfolio-action portfolio-action--repo"
              aria-label={`View source code of ${item.title}`}
            >
              <span class="action-text">SOURCE</span>
              <span class="action-arrow">→</span>
            </a>
          )
        }
        <!-- Link to detail page -->
        <a
          href={`/portfolio/${item.slug}`}
          class="portfolio-action portfolio-action--detail"
          aria-label={`View details of ${item.title}`}
        >
          <span class="action-text">LEARN MORE</span>
          <span class="action-arrow">→</span>
        </a>
      </div>
    </footer>
  </div>
</article>

<script>
  // Portfolio card expand/collapse functionality
  document.addEventListener('DOMContentLoaded', () => {
    const portfolioCards = document.querySelectorAll('.portfolio-card');

    portfolioCards.forEach((card) => {
      const toggleButton = card.querySelector('.portfolio-details-toggle');
      const toggleText = toggleButton?.querySelector('.toggle-text');
      const toggleArrow = toggleButton?.querySelector('.toggle-arrow');

      toggleButton?.addEventListener('click', (e) => {
        e.stopPropagation();

        const isExpanded = card.classList.contains('expanded');
        const expandedContent = card.querySelector('.portfolio-expanded');

        if (!isExpanded) {
          // Expand
          card.classList.add('expanded');
          toggleButton.setAttribute('aria-expanded', 'true');
          expandedContent?.setAttribute('aria-hidden', 'false');

          if (toggleText) toggleText.textContent = 'Show Less';
          if (toggleArrow) toggleArrow.textContent = '↑';

          setTimeout(() => {
            expandedContent?.scrollIntoView({
              behavior: 'smooth',
              block: 'nearest',
            });
          }, 150);
        } else {
          // Collapse
          card.classList.remove('expanded');
          toggleButton.setAttribute('aria-expanded', 'false');
          expandedContent?.setAttribute('aria-hidden', 'true');

          if (toggleText) toggleText.textContent = 'Show Details';
          if (toggleArrow) toggleArrow.textContent = '↓';

          setTimeout(() => {
            card.scrollIntoView({
              behavior: 'smooth',
              block: 'nearest',
            });
          }, 150);
        }
      });
    });
  });
</script>

<style>
  .portfolio-card {
    background: var(--glass-bg-secondary);
    backdrop-filter: blur(var(--glass-blur-container));
    border: 1px solid var(--glass-border-light);
    border-radius: var(--glass-radius);
    padding: 1.5rem;
    position: relative;
    overflow: hidden;
    cursor: pointer;
    min-height: 320px; /* Increased minimum height */
    height: auto;
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    display: flex;
    flex-direction: column;
  }

  .portfolio-card.expanded {
    transform: translateY(-4px);
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15);
    border-color: var(--color-accent-primary);
    background: var(--glass-bg-primary);
    min-height: auto; /* Allow expansion */
  }

  .portfolio-card:focus-within {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
  }

  /* Featured styling */
  .portfolio-card--featured {
    border-color: var(--color-accent-primary);
    box-shadow: 0 0 20px rgba(var(--color-accent-primary), 0.2);
  }

  .portfolio-featured-indicator {
    position: absolute;
    top: -1px;
    right: -1px;
    background: var(--color-accent-primary);
    color: white;
    padding: 0.4rem 0.8rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    border-radius: 0 var(--glass-radius) 0 var(--glass-radius-sm);
    z-index: 10;
  }

  /* Always visible preview content */
  .portfolio-preview {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex: 1; /* Take available space */
  }

  /* Media Section */
  .portfolio-media {
    position: relative;
    width: 100%;
    height: 200px; /* Fixed height instead of aspect ratio */
    overflow: hidden;
    background: var(--glass-bg-tertiary);
    border-radius: calc(var(--glass-radius) * 0.5);
    flex-shrink: 0; /* Prevent shrinking */
  }

  .portfolio-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.3s ease;
    display: block;
  }

  .portfolio-card:hover .portfolio-image {
    transform: scale(1.05);
  }

  .portfolio-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      135deg,
      var(--glass-bg-secondary),
      var(--glass-bg-tertiary)
    );
  }

  .portfolio-media-type {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-secondary);
    letter-spacing: 0.1em;
    text-align: center;
  }

  /* Type Badge */
  .portfolio-type-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.25rem 0.5rem;
    background: var(--glass-bg-primary);
    backdrop-filter: blur(var(--glass-blur-button));
    border: 1px solid var(--glass-border-medium);
    border-radius: calc(var(--glass-radius) * 0.25);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Header */
  .portfolio-header {
    flex: 1;
  }

  .portfolio-title {
    font-size: clamp(1.1rem, 2.2vw, 1.3rem);
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 0.5rem 0;
    line-height: 1.2;
  }

  .portfolio-client {
    font-size: 0.8rem;
    color: var(--color-accent-primary);
    font-weight: 600;
    letter-spacing: 0.05em;
    margin: 0;
  }

  /* Details Toggle Button */
  .portfolio-details-toggle {
    background: var(--glass-bg-tertiary);
    border: 1px solid var(--glass-border-light);
    border-radius: calc(var(--glass-radius) * 0.5);
    padding: 0.75rem 1rem;
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    margin-top: auto;
  }

  .portfolio-details-toggle:hover {
    background: var(--glass-bg-primary);
    border-color: var(--color-accent-primary);
    color: var(--color-accent-primary);
    transform: translateY(-1px);
  }

  .toggle-arrow {
    font-size: 1rem;
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .portfolio-card.expanded .portfolio-details-toggle {
    background: var(--glass-bg-primary);
    border-color: var(--color-accent-primary);
    color: var(--color-accent-primary);
  }

  /* Expandable content */
  .portfolio-expanded {
    position: static;
    display: none;
    flex-direction: column;
    gap: 1rem;
    padding-top: 1rem;
    margin-top: 1rem;
    border-top: 1px solid var(--glass-border-light);
  }

  .portfolio-card.expanded .portfolio-expanded {
    display: flex;
  }

  .portfolio-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .portfolio-description {
    color: var(--color-text-secondary);
    line-height: 1.5;
    font-size: 0.9rem;
  }

  /* Technologies */
  .portfolio-technologies {
    margin-bottom: 1rem;
  }

  .tech-title {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-accent-primary);
    margin: 0 0 0.6rem 0;
    letter-spacing: 0.05em;
  }

  .tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .tech-tag,
  .tech-more {
    font-size: 0.75rem;
    padding: 0.125rem 0.375rem;
    background: var(--glass-bg-tertiary);
    border: 1px solid var(--glass-border-medium);
    border-radius: calc(var(--glass-radius) * 0.25);
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  .tech-more {
    background: var(--glass-bg-primary);
    color: var(--color-text-primary);
    font-weight: 600;
  }

  /* Tags */
  .portfolio-tags {
    margin-bottom: 1rem;
  }

  .tags-title {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-accent-primary);
    margin: 0 0 0.6rem 0;
    letter-spacing: 0.05em;
  }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .tag-item,
  .tag-more {
    font-size: 0.75rem;
    color: var(--color-text-tertiary);
    font-weight: 500;
  }

  .tag-more {
    color: var(--color-text-secondary);
    font-weight: 600;
  }

  /* Footer Actions */
  .portfolio-footer {
    display: flex;
    justify-content: center;
    padding-top: 1rem;
    border-top: 1px solid var(--glass-border-light);
  }

  .portfolio-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  .portfolio-action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-accent-primary);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    padding: 0.5rem 1rem;
    border-radius: calc(var(--glass-radius) * 0.5);
    background: var(--glass-bg-tertiary);
    border: 1px solid var(--glass-border-light);
  }

  .portfolio-action:hover {
    color: var(--color-accent-secondary);
    transform: translateX(4px);
  }

  .portfolio-action:focus {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
  }

  .action-arrow {
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .portfolio-action:hover .action-arrow {
    transform: translateX(4px);
  }

  /* Responsive design */
  @media (max-width: 768px) {
    .portfolio-card {
      padding: 1.2rem;
      min-height: 240px;
    }

    .portfolio-title {
      font-size: 1.1rem;
    }

    .portfolio-actions {
      flex-direction: column;
    }

    .portfolio-action {
      justify-content: center;
      text-align: center;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .portfolio-card {
      transition: none;
    }

    .portfolio-card:hover {
      transform: none;
    }

    .portfolio-action:hover {
      transform: none;
    }

    .portfolio-action:hover .action-arrow {
      transform: none;
    }
  }
</style>
