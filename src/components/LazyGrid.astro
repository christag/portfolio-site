---
// LazyGrid.astro - Lazy loading grid container with progressive hydration
export interface Props {
  class?: string;
  variant?: 'standard' | 'chaos' | 'print';
  columns?: number;
  gap?: string;
  loadingStrategy?: 'viewport' | 'progressive' | 'priority';
  batchSize?: number;
  rootMargin?: string;
  threshold?: number;
}

const {
  class: className = '',
  variant = 'standard',
  columns = 12,
  gap = 'gap-6',
  loadingStrategy = 'viewport',
  batchSize = 4,
  rootMargin = '100px',
  threshold = 0.1,
} = Astro.props;

const gridClasses = {
  standard: 'grid-cols-12',
  chaos:
    'grid-cols-12 [&>*:nth-child(odd)]:col-start-2 [&>*:nth-child(3n)]:col-span-8',
  print:
    'grid-cols-12 [&>*:first-child]:col-span-full [&>*:nth-child(2)]:col-span-8 [&>*:nth-child(3)]:col-span-4',
};

const baseClasses = `lazy-grid grid ${gridClasses[variant]} ${gap} ${className}`;
---

<div
  class={baseClasses}
  data-lazy-grid
  data-loading-strategy={loadingStrategy}
  data-batch-size={batchSize}
  data-root-margin={rootMargin}
  data-threshold={threshold}
>
  <slot />
</div>

<!-- Loading indicator for progressive loading -->
<div class="lazy-grid-loading" data-grid-loading aria-hidden="true">
  <div class="lazy-grid-loading__content">
    <div class="lazy-grid-loading__spinner"></div>
    <p class="lazy-grid-loading__text">Loading more items...</p>
  </div>
</div>

<style>
  .lazy-grid {
    position: relative;
  }

  /* Grid item lazy loading states */
  .lazy-grid :global([data-lazy-item]) {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
  }

  .lazy-grid :global([data-lazy-item].loaded) {
    opacity: 1;
    transform: translateY(0);
  }

  .lazy-grid :global([data-lazy-item].loading) {
    opacity: 0.5;
  }

  /* Staggered animation for batch loading */
  .lazy-grid :global([data-lazy-item].loaded:nth-child(1)) {
    transition-delay: 0ms;
  }

  .lazy-grid :global([data-lazy-item].loaded:nth-child(2)) {
    transition-delay: 100ms;
  }

  .lazy-grid :global([data-lazy-item].loaded:nth-child(3)) {
    transition-delay: 200ms;
  }

  .lazy-grid :global([data-lazy-item].loaded:nth-child(4)) {
    transition-delay: 300ms;
  }

  .lazy-grid :global([data-lazy-item].loaded:nth-child(5)) {
    transition-delay: 400ms;
  }

  /* Skeleton placeholders for grid items */
  .lazy-grid :global([data-lazy-item].skeleton) {
    background: var(--glass-bg-primary);
    backdrop-filter: blur(var(--glass-blur-container));
    border: 1px solid var(--glass-border-medium);
    border-radius: var(--glass-radius);
    min-height: 300px;
    position: relative;
    overflow: hidden;
  }

  .lazy-grid :global([data-lazy-item].skeleton::before) {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.1),
      transparent
    );
    animation: skeleton-shimmer 1.5s infinite;
  }

  @keyframes skeleton-shimmer {
    0% {
      left: -100%;
    }
    100% {
      left: 100%;
    }
  }

  /* Loading indicator */
  .lazy-grid-loading {
    display: none;
    justify-content: center;
    align-items: center;
    padding: var(--space-xl);
    margin-top: var(--space-lg);
  }

  .lazy-grid-loading.visible {
    display: flex;
  }

  .lazy-grid-loading__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    background: var(--glass-bg-primary);
    backdrop-filter: blur(var(--glass-blur-container));
    border: 1px solid var(--glass-border-medium);
    border-radius: var(--glass-radius);
    padding: var(--space-lg);
    box-shadow: 0 4px 16px var(--glass-shadow-light);
  }

  .lazy-grid-loading__spinner {
    width: 32px;
    height: 32px;
    border: 3px solid var(--glass-border-medium);
    border-top: 3px solid var(--color-accent-primary);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  .lazy-grid-loading__text {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    font-weight: 500;
    margin: 0;
  }

  @keyframes spin {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .lazy-grid :global([data-lazy-item]) {
      transition: none;
    }

    .lazy-grid :global([data-lazy-item].skeleton::before) {
      animation: none;
    }

    .lazy-grid-loading__spinner {
      animation: none;
      border: 3px solid var(--color-accent-primary);
    }
  }

  /* High contrast mode */
  @media (prefers-contrast: high) {
    .lazy-grid :global([data-lazy-item].skeleton) {
      background: Canvas;
      border: 2px solid CanvasText;
    }
  }

  /* Print styles */
  @media print {
    .lazy-grid :global([data-lazy-item]) {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }

    .lazy-grid-loading {
      display: none !important;
    }
  }
</style>

<script>
  // Lazy grid loading with Intersection Observer
  class LazyGridLoader {
    private grid: HTMLElement;
    private observer: IntersectionObserver | null = null;
    private loadedItems = new Set<HTMLElement>();
    private loadingStrategy: string;
    private batchSize: number;
    private currentBatch = 0;
    private loadingIndicator: HTMLElement | null = null;

    constructor(grid: HTMLElement) {
      this.grid = grid;
      this.loadingStrategy = grid.dataset.loadingStrategy || 'viewport';
      this.batchSize = parseInt(grid.dataset.batchSize || '4');
      this.loadingIndicator = document.querySelector('[data-grid-loading]');

      this.initializeObserver();
      this.setupLazyItems();
      this.startLoading();
    }

    private initializeObserver() {
      if (!('IntersectionObserver' in window)) {
        this.loadAllItems();
        return;
      }

      const rootMargin = this.grid.dataset.rootMargin || '100px';
      const threshold = parseFloat(this.grid.dataset.threshold || '0.1');

      this.observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              this.loadItem(entry.target as HTMLElement);
            }
          });
        },
        {
          rootMargin,
          threshold,
        }
      );
    }

    private setupLazyItems() {
      const items = this.grid.children;
      Array.from(items).forEach((item, index) => {
        const element = item as HTMLElement;
        element.setAttribute('data-lazy-item', '');
        element.setAttribute('data-item-index', index.toString());

        if (this.loadingStrategy === 'progressive') {
          element.classList.add('skeleton');
        }
      });
    }

    private startLoading() {
      switch (this.loadingStrategy) {
        case 'viewport':
          this.observeAllItems();
          break;
        case 'progressive':
          this.loadNextBatch();
          break;
        case 'priority':
          this.loadPriorityItems();
          break;
      }
    }

    private observeAllItems() {
      if (!this.observer) return;

      const items = this.grid.querySelectorAll('[data-lazy-item]');
      items.forEach((item) => {
        this.observer!.observe(item);
      });
    }

    private async loadNextBatch() {
      const items = Array.from(this.grid.querySelectorAll('[data-lazy-item]'));
      const startIndex = this.currentBatch * this.batchSize;
      const endIndex = Math.min(startIndex + this.batchSize, items.length);
      const batchItems = items.slice(startIndex, endIndex);

      if (batchItems.length === 0) {
        this.hideLoadingIndicator();
        return;
      }

      this.showLoadingIndicator();

      // Load batch with staggered timing
      for (let i = 0; i < batchItems.length; i++) {
        setTimeout(() => {
          this.loadItem(batchItems[i] as HTMLElement);
        }, i * 100);
      }

      this.currentBatch++;

      // Continue loading next batch after delay
      if (endIndex < items.length) {
        setTimeout(() => {
          this.loadNextBatch();
        }, 800);
      } else {
        setTimeout(() => {
          this.hideLoadingIndicator();
        }, 500);
      }
    }

    private loadPriorityItems() {
      // Load featured/priority items first
      const priorityItems = this.grid.querySelectorAll(
        '[data-lazy-item][data-featured="true"]'
      );
      const regularItems = this.grid.querySelectorAll(
        '[data-lazy-item]:not([data-featured="true"])'
      );

      // Load priority items immediately
      priorityItems.forEach((item) => {
        this.loadItem(item as HTMLElement);
      });

      // Observe regular items for viewport loading
      if (this.observer) {
        regularItems.forEach((item) => {
          this.observer!.observe(item);
        });
      }
    }

    private async loadItem(element: HTMLElement) {
      if (this.loadedItems.has(element)) return;

      this.loadedItems.add(element);
      element.classList.add('loading');
      element.classList.remove('skeleton');

      try {
        // Simulate content loading (in real app, this might load additional data)
        await this.simulateContentLoad();

        // Mark as loaded with animation
        element.classList.remove('loading');
        element.classList.add('loaded');

        // Stop observing this item
        if (this.observer) {
          this.observer.unobserve(element);
        }

        // Trigger custom event for loaded item
        element.dispatchEvent(
          new CustomEvent('item-loaded', {
            bubbles: true,
            detail: { element },
          })
        );
      } catch (error) {
        console.warn('Failed to load grid item:', error);
        element.classList.remove('loading');
        element.classList.add('error');
      }
    }

    private simulateContentLoad(): Promise<void> {
      // In a real implementation, this might:
      // - Load additional data from API
      // - Initialize interactive components
      // - Process images or media
      return new Promise((resolve) => {
        setTimeout(resolve, Math.random() * 200 + 100);
      });
    }

    private loadAllItems() {
      // Fallback for browsers without IntersectionObserver
      const items = this.grid.querySelectorAll('[data-lazy-item]');
      items.forEach((item) => {
        this.loadItem(item as HTMLElement);
      });
    }

    private showLoadingIndicator() {
      if (this.loadingIndicator) {
        this.loadingIndicator.classList.add('visible');
        this.loadingIndicator.setAttribute('aria-hidden', 'false');
      }
    }

    private hideLoadingIndicator() {
      if (this.loadingIndicator) {
        this.loadingIndicator.classList.remove('visible');
        this.loadingIndicator.setAttribute('aria-hidden', 'true');
      }
    }

    public refresh() {
      // Re-setup for dynamically added items
      this.setupLazyItems();
      this.startLoading();
    }

    public destroy() {
      if (this.observer) {
        this.observer.disconnect();
      }
    }
  }

  // Initialize lazy grids
  function initializeLazyGrids() {
    const grids = document.querySelectorAll('[data-lazy-grid]');
    grids.forEach((grid) => {
      new LazyGridLoader(grid as HTMLElement);
    });
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeLazyGrids);
  } else {
    initializeLazyGrids();
  }

  // Export for use by other scripts
  (window as any).LazyGridLoader = LazyGridLoader;
</script>
