---
export interface Props {
  service: {
    id: number;
    title: string;
    description: string;
    category?: string;
    featureHighlights?: string[];
    tiers?: Array<{
      name: string;
      priceLow?: number;
      priceHigh?: number;
      deliverables?: string[];
    }>;
    contactMethod?: string;
    isPinned?: boolean;
    slug: string;
  };
  index?: number;
}

const { service, index = 0 } = Astro.props;

// Determine pricing display
const getLowestPrice = () => {
  if (!service.tiers || service.tiers.length === 0) return null;
  const prices = service.tiers
    .filter((tier) => tier.priceLow)
    .map((tier) => tier.priceLow!);
  return prices.length > 0 ? Math.min(...prices) : null;
};

const getHighestPrice = () => {
  if (!service.tiers || service.tiers.length === 0) return null;
  const prices = service.tiers
    .filter((tier) => tier.priceHigh)
    .map((tier) => tier.priceHigh!);
  return prices.length > 0 ? Math.max(...prices) : null;
};

const lowestPrice = getLowestPrice();
const highestPrice = getHighestPrice();

// Punk-style misalignment based on index
const misalignmentClass =
  index % 3 === 0 ? 'misalign-left' : index % 3 === 1 ? 'misalign-right' : '';
---

<article
  class={`service-card glassmorphism-card ${misalignmentClass} ${service.isPinned ? 'pinned' : ''}`}
  role="article"
  aria-labelledby={`service-title-${service.id}`}
>
  {
    service.isPinned && (
      <div class="pin-indicator" aria-label="Featured service">
        <span class="pin-text">[ FEATURED ]</span>
      </div>
    )
  }

  <!-- Always visible content -->
  <div class="service-preview">
    <header class="service-header">
      <h3 id={`service-title-${service.id}`} class="service-title">
        {service.title}
      </h3>
      {
        service.category && (
          <span class="service-category">
            // {service.category.toUpperCase()}
          </span>
        )
      }
    </header>

    {
      (lowestPrice || highestPrice) && (
        <div class="pricing-preview">
          <span class="pricing-label">FROM</span>
          <span class="price-range">
            {lowestPrice && `$${lowestPrice.toLocaleString()}`}
            {lowestPrice &&
              highestPrice &&
              lowestPrice !== highestPrice &&
              ` - $${highestPrice.toLocaleString()}`}
          </span>
        </div>
      )
    }
  </div>

  <!-- Expandable content that appears on hover -->
  <div class="service-expanded">
    <div class="service-content">
      <p class="service-description">
        {service.description}
      </p>

      {
        service.featureHighlights && service.featureHighlights.length > 0 && (
          <div class="feature-highlights">
            <h4 class="features-title">[ HIGHLIGHTS ]</h4>
            <ul class="features-list" role="list">
              {service.featureHighlights.slice(0, 4).map((feature) => (
                <li class="feature-item">▸ {feature}</li>
              ))}
              {service.featureHighlights.length > 4 && (
                <li class="feature-more">
                  + {service.featureHighlights.length - 4} more
                </li>
              )}
            </ul>
          </div>
        )
      }
    </div>

    <footer class="service-footer">
      <a
        href={`/services/${service.slug}`}
        class="service-link"
        aria-label={`View details for ${service.title}`}
      >
        <span class="link-text">LEARN MORE</span>
        <span class="link-arrow">→</span>
      </a>
    </footer>
  </div>
</article>

<style>
  .service-card {
    background: var(--glass-bg-secondary);
    backdrop-filter: blur(var(--glass-blur-card));
    border: 1px solid var(--glass-border-light);
    border-radius: var(--glass-radius-lg);
    padding: 1.5rem;
    position: relative;
    overflow: hidden;
    cursor: pointer;

    /* Compact default size */
    height: 180px;

    /* U-shaped animation curve with 1.2s max duration */
    transition: all 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .service-card:hover {
    /* Expand downward on hover */
    height: 320px;
    transform: translateY(-8px);
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15);
    border-color: var(--accent-primary);
    background: var(--glass-bg-primary);
  }

  .service-card:focus-within {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }

  /* Punk-style misalignment - reduced for compact cards */
  .misalign-left {
    transform: rotate(-0.5deg);
    margin-left: -4px;
  }

  .misalign-right {
    transform: rotate(0.5deg);
    margin-right: -4px;
  }

  .misalign-left:hover {
    transform: rotate(-0.5deg) translateY(-8px);
  }

  .misalign-right:hover {
    transform: rotate(0.5deg) translateY(-8px);
  }

  /* Pinned/Featured styling */
  .pinned {
    border-color: var(--accent-primary);
    box-shadow: 0 0 20px rgba(var(--accent-primary-rgb), 0.2);
  }

  .pin-indicator {
    position: absolute;
    top: -1px;
    right: -1px;
    background: var(--accent-primary);
    color: var(--text-on-accent);
    padding: 0.4rem 0.8rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    border-radius: 0 var(--glass-radius-lg) 0 var(--glass-radius-md);
    z-index: 10;
  }

  /* Always visible preview content */
  .service-preview {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .service-header {
    margin-bottom: 1rem;
  }

  .service-title {
    font-size: clamp(1.1rem, 2.2vw, 1.3rem);
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.5rem 0;
    line-height: 1.2;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .service-category {
    font-size: 0.8rem;
    color: var(--accent-primary);
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .pricing-preview {
    background: var(--glass-bg-tertiary);
    border: 1px solid var(--glass-border-light);
    border-radius: var(--glass-radius-md);
    padding: 0.8rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-top: auto;
  }

  .pricing-label {
    font-size: 0.7rem;
    color: var(--text-secondary);
    font-weight: 600;
    letter-spacing: 0.1em;
    margin-bottom: 0.25rem;
  }

  .price-range {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--accent-primary);
  }

  /* Expandable content - hidden by default */
  .service-expanded {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.5rem;

    /* Initially hidden and positioned below */
    opacity: 0;
    transform: translateY(20px);
    pointer-events: none;

    /* U-shaped animation curve */
    transition: all 1s cubic-bezier(0.25, 0.46, 0.45, 0.94);

    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--glass-bg-primary);
    backdrop-filter: blur(var(--glass-blur-card));
    border-radius: var(--glass-radius-lg);
  }

  .service-card:hover .service-expanded {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .service-content {
    flex: 1;
    overflow-y: auto;
    margin-bottom: 1rem;
  }

  .service-description {
    color: var(--text-secondary);
    line-height: 1.5;
    font-size: 0.9rem;
    margin-bottom: 1.2rem;
  }

  .feature-highlights {
    margin-bottom: 1rem;
  }

  .features-title {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent-primary);
    margin: 0 0 0.6rem 0;
    letter-spacing: 0.05em;
  }

  .features-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .feature-item {
    color: var(--text-secondary);
    font-size: 0.8rem;
    margin-bottom: 0.4rem;
    display: flex;
    align-items: flex-start;
    gap: 0.4rem;
  }

  .feature-more {
    color: var(--accent-primary);
    font-size: 0.8rem;
    font-weight: 600;
    margin-top: 0.2rem;
  }

  .service-footer {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--glass-border-light);
  }

  .service-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent-primary);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    padding: 0.5rem 0;
  }

  .service-link:hover {
    color: var(--accent-secondary);
    transform: translateX(4px);
  }

  .service-link:focus {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }

  .link-arrow {
    transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .service-link:hover .link-arrow {
    transform: translateX(4px);
  }

  /* Responsive design */
  @media (max-width: 768px) {
    .service-card {
      padding: 1.2rem;
      height: 160px;
    }

    .service-card:hover {
      height: 280px;
    }

    .misalign-left,
    .misalign-right {
      transform: none;
      margin: 0;
    }

    .misalign-left:hover,
    .misalign-right:hover {
      transform: translateY(-6px);
    }

    .service-title {
      font-size: 1.1rem;
    }
  }

  @media (max-width: 480px) {
    .service-card {
      height: 140px;
    }

    .service-card:hover {
      height: 260px;
    }
  }

  /* Dark mode adjustments */
  [data-theme='dark'] .service-card {
    background: var(--glass-bg-secondary);
    border-color: var(--glass-border-dark);
  }

  [data-theme='dark'] .service-card:hover {
    border-color: var(--accent-primary);
    background: var(--glass-bg-primary);
  }

  [data-theme='dark'] .service-expanded {
    background: var(--glass-bg-primary);
  }

  /* High contrast mode */
  @media (prefers-contrast: high) {
    .service-card {
      border-width: 2px;
    }

    .service-title {
      font-weight: 800;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .service-card {
      transition: none;
    }

    .service-card:hover {
      transform: none;
      height: auto;
    }

    .service-expanded {
      position: static;
      opacity: 1;
      transform: none;
      pointer-events: auto;
      background: transparent;
    }

    .misalign-left,
    .misalign-right {
      transform: none;
    }

    .service-link:hover {
      transform: none;
    }

    .service-link:hover .link-arrow {
      transform: none;
    }
  }
</style>
