---
import Navigation from '../components/navigation/Navigation.astro';
import Footer from '../components/footer/Footer.astro';
import DynamicBackground from '../components/DynamicBackground.astro';

// Import styles properly through Astro
import '../styles/variables.scss';
import '../styles/global.css';
import '../styles/utilities.scss';

export interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Christopher Tagliaferro - Technology Consultant & Virtual CIO',
} = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Default meta tags -->
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover, user-scalable=no"
    />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>

    <!-- iOS Safari Theme Colors & Status Bar -->
    <!-- Dynamic theme-color that changes with theme -->
    <meta name="theme-color" content="#fafafa" />

    <!-- iOS Safari Status Bar Styling -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Christopher T" />

    <!-- Safari-specific meta tags for minimal UI -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="format-detection" content="telephone=no" />

    <!-- Force Safari minimal UI -->
    <meta name="apple-touch-fullscreen" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />

    <!-- iOS Safari Touch Icons -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="apple-touch-icon" sizes="152x152" href="/apple-touch-icon.png" />
    <link rel="apple-touch-icon" sizes="120x120" href="/apple-touch-icon.png" />
    <link rel="apple-touch-icon" sizes="76x76" href="/apple-touch-icon.png" />

    <!-- iOS Safari Splash Screens for different devices -->
    <link
      rel="apple-touch-startup-image"
      href="/favicon.svg"
      media="(device-width: 320px) and (device-height: 568px) and (-webkit-device-pixel-ratio: 2)"
    />
    <link
      rel="apple-touch-startup-image"
      href="/favicon.svg"
      media="(device-width: 375px) and (device-height: 667px) and (-webkit-device-pixel-ratio: 2)"
    />
    <link
      rel="apple-touch-startup-image"
      href="/favicon.svg"
      media="(device-width: 414px) and (device-height: 736px) and (-webkit-device-pixel-ratio: 3)"
    />
    <link
      rel="apple-touch-startup-image"
      href="/favicon.svg"
      media="(device-width: 375px) and (device-height: 812px) and (-webkit-device-pixel-ratio: 3)"
    />

    <!-- Web App Manifest -->
    <link rel="manifest" href="/manifest.json" />

    <!-- iOS Safari Preconnect for Performance -->
    <link rel="dns-prefetch" href="//booking.christagliaferro.com" />
    <link rel="preconnect" href="//booking.christagliaferro.com" crossorigin />

    <!-- Enhanced SEO metadata from page-specific SEO component -->
    <slot name="head" />

    <!-- View Transitions API meta tag for supported browsers -->
    <meta name="view-transition" content="same-origin" />

    <!-- Early theme initialization to prevent flash -->
    <script is:inline>
      // Initialize theme immediately with minimal DOM manipulation
      (function () {
        try {
          const theme = localStorage.getItem('theme') || 'light';

          // Set theme attribute immediately without DOM queries to prevent layout shift
          if (theme === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
          }
        } catch (error) {
          console.warn('Theme initialization failed:', error);
          // Fallback to light theme
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>

    <!-- Styles are imported at the top of the file -->
  </head>
  <body
    class="min-h-screen safari-minimal-ui"
    style="color: var(--color-text-primary, #171717);"
  >
    <!-- Dynamic Animated Background -->
    <DynamicBackground
      intensity="medium"
      colorAccents={true}
      glitchEffects={true}
    />

    <Navigation currentPath={currentPath} />
    <main
      class="pt-20 pb-32 mobile-main"
      style="view-transition-name: main-content"
    >
      <slot />
    </main>
    <Footer />

    <!-- Mobile-specific layout fixes -->
    <style>
      /* iOS Safari Safe Area Support */
      body {
        /* Support for iPhone X+ notch and home indicator */
        padding-top: env(safe-area-inset-top);
        padding-bottom: env(safe-area-inset-bottom);
        padding-left: env(safe-area-inset-left);
        padding-right: env(safe-area-inset-right);
      }

      /* MOBILE FIX: Adjust main content spacing for mobile */
      @media (max-width: 767px) {
        .mobile-main {
          padding-top: 4.25rem; /* 68px - matches mobile nav height */
          padding-bottom: 4rem; /* Reduced for compact footer */
          min-height: calc(100vh - 4.25rem);
          min-height: calc((var(--vh, 1vh) * 100) - 4.25rem);
        }
      }

      @media (max-width: 479px) {
        .mobile-main {
          padding-top: 4rem; /* 64px - slightly less for very small screens */
          padding-bottom: 3rem; /* Much smaller for compact footer */
          min-height: calc(100vh - 4rem);
          min-height: calc((var(--vh, 1vh) * 100) - 4rem);
        }
      }

      /* iOS Safari specific fixes */
      @supports (-webkit-touch-callout: none) {
        /* iOS Safari only styles */
        .mobile-main {
          /* Account for dynamic island and status bar */
          padding-top: calc(4.25rem + env(safe-area-inset-top));
          padding-bottom: calc(
            4rem + env(safe-area-inset-bottom)
          ); /* Reduced for compact footer */
          min-height: calc(
            100vh - env(safe-area-inset-top) - env(safe-area-inset-bottom)
          );
          min-height: calc(
            (var(--vh, 1vh) * 100) - env(safe-area-inset-top) -
              env(safe-area-inset-bottom)
          );
        }

        @media (max-width: 479px) {
          .mobile-main {
            padding-top: calc(4rem + env(safe-area-inset-top));
            padding-bottom: calc(
              3rem + env(safe-area-inset-bottom)
            ); /* Much smaller for compact footer */
          }
        }

        /* Prevent iOS Safari bounce scrolling issues but allow proper scrolling */
        body {
          position: relative;
          overflow-x: hidden;
          width: 100%;
          height: 100%;
        }

        .mobile-main {
          overflow-y: auto;
          -webkit-overflow-scrolling: touch;
        }
      }

      /* Ensure all content containers respect mobile boundaries */
      .content-wrapper,
      .container-fluid,
      .container-constrained {
        max-width: 100vw;
        /* Removed overflow-x: hidden to prevent drop shadow clipping */
        box-sizing: border-box;
        padding-left: 1rem;
        padding-right: 1rem;
      }

      /* Prevent any element from creating horizontal overflow */
      * {
        box-sizing: border-box;
      }

      img,
      video,
      canvas,
      svg {
        max-width: 100%;
        height: auto;
      }

      /* Text containment for mobile */
      p,
      h1,
      h2,
      h3,
      h4,
      h5,
      h6,
      span,
      div {
        word-wrap: break-word;
        overflow-wrap: break-word;
        hyphens: auto;
      }

      /* Responsive typography */
      .text-responsive {
        font-size: clamp(1rem, 2.5vw, 1.25rem);
        line-height: 1.4;
      }

      .heading-responsive {
        font-size: clamp(1.5rem, 5vw, 3rem);
        line-height: 0.9;
        letter-spacing: -0.025em;
      }

      .display-responsive {
        font-size: clamp(2rem, 8vw, 6rem);
        line-height: 0.8;
        letter-spacing: -0.05em;
      }

      /* iOS Safari haptic feedback support */
      @media (hover: none) and (pointer: coarse) {
        button,
        .button,
        a[role='button'],
        input[type='submit'],
        input[type='button'] {
          /* Enable haptic feedback on iOS */
          -webkit-tap-highlight-color: transparent;
          touch-action: manipulation;
        }
      }

      /* iOS Safari pull-to-refresh prevention */
      body {
        overscroll-behavior-y: none;
      }

      /* iOS Safari zoom prevention on form inputs */
      input[type='text'],
      input[type='email'],
      input[type='password'],
      input[type='search'],
      input[type='tel'],
      input[type='url'],
      select,
      textarea {
        font-size: 16px; /* Prevents zoom on iOS Safari */
      }
    </style>

    <!-- Theme switching functionality with iOS Safari theme color updates -->
    <script>
      // Theme toggle functionality
      function toggleTheme() {
        const html = document.documentElement;
        const currentTheme = html.getAttribute('data-theme') || 'light';
        const newTheme = currentTheme === 'light' ? 'dark' : 'light';

        html.setAttribute('data-theme', newTheme);
        localStorage.setItem('theme', newTheme);

        // Update iOS Safari theme color dynamically
        updateThemeColor(newTheme === 'dark');

        // Dispatch custom event for components that need to react to theme changes
        window.dispatchEvent(
          new CustomEvent('themeChanged', { detail: { theme: newTheme } })
        );
      }

      // Dynamic theme color updates based on current theme
      function updateThemeColor(isDark: boolean) {
        // Use theme-appropriate colors for better WebKit integration
        const lightThemeColor = '#fafafa'; // Light background with slight pink tint
        const darkThemeColor = '#1a1a1a'; // Dark background that works with dark mode

        const themeColor = isDark ? darkThemeColor : lightThemeColor;

        const themeColorMeta = document.querySelector(
          'meta[name="theme-color"]'
        );
        if (themeColorMeta) {
          themeColorMeta.setAttribute('content', themeColor);
          console.log(
            `🎨 Updated theme-color to: ${themeColor} (${isDark ? 'dark' : 'light'} theme)`
          );
        }

        // Also update the apple-mobile-web-app-status-bar-style for better iOS integration
        const statusBarMeta = document.querySelector(
          'meta[name="apple-mobile-web-app-status-bar-style"]'
        );
        if (statusBarMeta) {
          // Use 'black-translucent' for dark theme, 'default' for light theme
          const statusBarStyle = isDark ? 'black-translucent' : 'default';
          statusBarMeta.setAttribute('content', statusBarStyle);
          console.log(`📱 Updated status bar style to: ${statusBarStyle}`);
        }
      }

      // Make function globally available
      (window as any).toggleTheme = toggleTheme;

      // Initialize theme color and system preferences after DOM loads
      document.addEventListener('DOMContentLoaded', function () {
        const savedTheme = localStorage.getItem('theme') || 'light';

        // Apply theme if not already set (prevents flash)
        if (!document.documentElement.getAttribute('data-theme')) {
          document.documentElement.setAttribute('data-theme', savedTheme);
        }

        // Update theme color after DOM is ready
        updateThemeColor(savedTheme === 'dark');

        // Listen for system theme changes
        if (window.matchMedia) {
          window
            .matchMedia('(prefers-color-scheme: dark)')
            .addEventListener('change', (e) => {
              if (!localStorage.getItem('theme')) {
                updateThemeColor(e.matches);
              }
            });
        }
      });

      // iOS Safari specific enhancements
      if ('serviceWorker' in navigator) {
        // Register service worker for PWA functionality with better error handling
        navigator.serviceWorker
          .register('/sw.js', {
            scope: '/',
            updateViaCache: 'none', // Don't cache the service worker itself
          })
          .then((registration) => {
            console.log(
              '✅ Service Worker registered successfully:',
              registration
            );

            // Check for updates on page focus
            document.addEventListener('visibilitychange', () => {
              if (!document.hidden) {
                registration.update().catch((error) => {
                  console.warn('SW update failed:', error);
                });
              }
            });

            // Handle service worker updates
            registration.addEventListener('updatefound', () => {
              const newWorker = registration.installing;
              if (newWorker) {
                newWorker.addEventListener('statechange', () => {
                  if (
                    newWorker.state === 'installed' &&
                    navigator.serviceWorker.controller
                  ) {
                    // New service worker is available
                    console.log('🔄 New service worker available');
                  }
                });
              }
            });
          })
          .catch((error) => {
            console.error('❌ Service Worker registration failed:', error);
            // Continue without service worker
          });
      } else {
        console.log('⚠️ Service Workers not supported in this browser');
      }

      // iOS Safari viewport height fix
      function setViewportHeight() {
        const vh = window.innerHeight * 0.01;
        document.documentElement.style.setProperty('--vh', `${vh}px`);
      }

      setViewportHeight();
      window.addEventListener('resize', setViewportHeight);
      window.addEventListener('orientationchange', setViewportHeight);

      // Force Safari to hide address bar and enable minimal UI
      function enableSafariMinimalUI() {
        const isSafari =
          /Safari/.test(navigator.userAgent) &&
          !/Chrome/.test(navigator.userAgent);
        const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent);

        if (isSafari || isIOS) {
          // Force scroll to trigger minimal UI
          setTimeout(() => {
            window.scrollTo(0, 1);
            setTimeout(() => {
              window.scrollTo(0, 0);
              // Set proper viewport height after bars hide
              setViewportHeight();
            }, 100);
          }, 300);

          // Listen for scroll events to maintain minimal UI
          let ticking = false;
          const handleScroll = () => {
            if (!ticking) {
              requestAnimationFrame(() => {
                // Update theme color based on current theme (not scroll position)
                const currentTheme =
                  document.documentElement.getAttribute('data-theme') ||
                  'light';
                const isDark = currentTheme === 'dark';

                const themeColorMeta = document.querySelector(
                  'meta[name="theme-color"]'
                );
                if (themeColorMeta) {
                  const lightThemeColor = '#fafafa';
                  const darkThemeColor = '#1a1a1a';
                  const themeColor = isDark ? darkThemeColor : lightThemeColor;
                  themeColorMeta.setAttribute('content', themeColor);
                }
                ticking = false;
              });
              ticking = true;
            }
          };

          window.addEventListener('scroll', handleScroll, { passive: true });
        }
      }

      enableSafariMinimalUI();

      // iOS Safari scroll position restoration
      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }

      // Global error handler for resource loading failures
      window.addEventListener(
        'error',
        function (e) {
          if (e.target) {
            console.warn('Resource loading failed:', e.target);
            // Don't let resource loading errors crash the page
            e.preventDefault();
          }
        },
        true
      );

      // Handle unhandled promise rejections (like failed module imports)
      window.addEventListener('unhandledrejection', function (e) {
        console.warn('Unhandled promise rejection:', e.reason);
        // Prevent the error from crashing the page
        e.preventDefault();
      });
    </script>

    <!-- View Transitions API initialization - DISABLED for static site compatibility -->
    <script>
      // View transitions disabled to prevent routing issues with static sites
      document.addEventListener('DOMContentLoaded', () => {
        console.log('View Transitions disabled for static site compatibility');
      });
    </script>

    <!-- Initialize Animation System -->
    <script is:inline>
      // Basic animation initialization without module imports
      document.addEventListener('DOMContentLoaded', function () {
        // Add global animation classes if not already present
        if (!document.head.querySelector('#animation-styles')) {
          const style = document.createElement('style');
          style.id = 'animation-styles';
          style.textContent = `
            .animate-fade-in {
              opacity: 0;
              animation: fadeIn 0.3s ease-out forwards;
            }
            
            .animate-slide-up {
              transform: translateY(20px);
              opacity: 0;
              animation: slideUp 0.4s ease-out forwards;
            }
            
            .animate-scale-in {
              transform: scale(0.9);
              opacity: 0;
              animation: scaleIn 0.3s ease-out forwards;
            }
            
            @keyframes fadeIn {
              to { opacity: 1; }
            }
            
            @keyframes slideUp {
              to { 
                transform: translateY(0);
                opacity: 1;
              }
            }
            
            @keyframes scaleIn {
              to { 
                transform: scale(1);
                opacity: 1;
              }
            }
            
            @media (prefers-reduced-motion: reduce) {
              .animate-fade-in,
              .animate-slide-up,
              .animate-scale-in {
                animation: none !important;
                opacity: 1 !important;
                transform: none !important;
              }
            }
          `;
          document.head.appendChild(style);
        }

        console.log('🎭 Basic animation system initialized');
      });
    </script>
  </body>
</html>
<style is:global>
  /* iOS Safari custom properties for viewport */
  :root {
    --vh: 1vh;
  }

  /* Use custom viewport height for iOS Safari */
  .min-h-screen {
    min-height: 100vh;
    min-height: calc(var(--vh, 1vh) * 100);
  }

  /* Safari minimal UI - hide bars on scroll */
  .safari-minimal-ui {
    /* Enable momentum scrolling on iOS */
    -webkit-overflow-scrolling: touch;

    /* Force Safari to hide address bar on scroll */
    overflow-x: hidden;

    /* Ensure full height to trigger Safari minimal UI */
    min-height: 100vh;
    min-height: 100svh; /* Small viewport height for Safari */
  }

  /* iOS Safari specific optimizations */
  @supports (-webkit-touch-callout: none) {
    .safari-minimal-ui {
      /* Trigger minimal UI mode */
      min-height: 100vh;
      min-height: -webkit-fill-available;

      /* Force Safari to hide UI chrome */
      height: 100vh;
      height: -webkit-fill-available;
    }

    /* Ensure content fills the space when bars hide */
    body {
      min-height: 100vh;
      min-height: -webkit-fill-available;
    }
  }

  /* Modern Safari viewport units */
  @supports (height: 100svh) {
    .safari-minimal-ui {
      min-height: 100svh;
    }
  }
</style>
