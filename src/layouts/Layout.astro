---
import Navigation from '../components/navigation/Navigation.astro';
import Footer from '../components/footer/Footer.astro';
import DynamicBackground from '../components/DynamicBackground.astro';

export interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Christopher Tagliaferro - Technology Consultant & Virtual CIO',
} = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Default meta tags -->
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover, user-scalable=no"
    />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>

    <!-- iOS Safari Theme Colors & Status Bar -->
    <!-- Dynamic theme-color that changes with theme -->
    <meta name="theme-color" content="#b8869a" />

    <!-- iOS Safari Status Bar Styling -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />
    <meta name="apple-mobile-web-app-title" content="Christopher T" />

    <!-- Safari-specific meta tags for minimal UI -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="format-detection" content="telephone=no" />

    <!-- Force Safari minimal UI -->
    <meta name="apple-touch-fullscreen" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />

    <!-- iOS Safari Touch Icons -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="apple-touch-icon" sizes="152x152" href="/apple-touch-icon.png" />
    <link rel="apple-touch-icon" sizes="120x120" href="/apple-touch-icon.png" />
    <link rel="apple-touch-icon" sizes="76x76" href="/apple-touch-icon.png" />

    <!-- iOS Safari Splash Screens for different devices -->
    <link
      rel="apple-touch-startup-image"
      href="/favicon.svg"
      media="(device-width: 320px) and (device-height: 568px) and (-webkit-device-pixel-ratio: 2)"
    />
    <link
      rel="apple-touch-startup-image"
      href="/favicon.svg"
      media="(device-width: 375px) and (device-height: 667px) and (-webkit-device-pixel-ratio: 2)"
    />
    <link
      rel="apple-touch-startup-image"
      href="/favicon.svg"
      media="(device-width: 414px) and (device-height: 736px) and (-webkit-device-pixel-ratio: 3)"
    />
    <link
      rel="apple-touch-startup-image"
      href="/favicon.svg"
      media="(device-width: 375px) and (device-height: 812px) and (-webkit-device-pixel-ratio: 3)"
    />

    <!-- Web App Manifest -->
    <link rel="manifest" href="/manifest.json" />

    <!-- iOS Safari Preconnect for Performance -->
    <link rel="dns-prefetch" href="//booking.christagliaferro.com" />
    <link rel="preconnect" href="//booking.christagliaferro.com" crossorigin />

    <!-- Enhanced SEO metadata from page-specific SEO component -->
    <slot name="head" />

    <!-- View Transitions API meta tag for supported browsers -->
    <meta name="view-transition" content="same-origin" />

    <!-- Early theme initialization to prevent flash -->
    <script is:inline>
      // Initialize theme before any rendering
      (function () {
        const theme = localStorage.getItem('theme') || 'light';

        // Immediately set theme color based on saved preference - using accent color for visibility
        const lightColor = '#b8869a'; // Dusty pink accent (visible in light mode)
        const darkColor = '#b8869a'; // Same accent color (visible in dark mode)
        const currentColor = lightColor; // Use accent color for both themes

        // Update the single theme-color meta tag
        const themeColorMeta = document.querySelector(
          'meta[name="theme-color"]'
        );
        if (themeColorMeta) {
          themeColorMeta.setAttribute('content', currentColor);
        }
        if (theme === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark');
        }

        // Dynamic theme color updates based on current theme
        function updateThemeColor(isDark) {
          const accentColor = '#b8869a'; // Dusty pink accent - visible in both themes
          const newColor = accentColor;

          const themeColorMeta = document.querySelector(
            'meta[name="theme-color"]'
          );
          if (themeColorMeta) {
            themeColorMeta.setAttribute('content', newColor);
          }
        }

        // Set initial theme color
        updateThemeColor(theme === 'dark');

        // Listen for system theme changes
        if (window.matchMedia) {
          window
            .matchMedia('(prefers-color-scheme: dark)')
            .addEventListener('change', (e) => {
              if (!localStorage.getItem('theme')) {
                updateThemeColor(e.matches);
              }
            });
        }
      })();
    </script>

    <!-- Import styles in correct order -->
    <style>
      @import '../styles/variables.scss';
    </style>
  </head>
  <body
    class="min-h-screen safari-minimal-ui"
    style="color: var(--color-text-primary, #171717);"
  >
    <!-- Dynamic Animated Background -->
    <DynamicBackground
      intensity="medium"
      colorAccents={true}
      glitchEffects={true}
    />

    <Navigation currentPath={currentPath} />
    <main
      class="pt-20 pb-32 mobile-main"
      style="view-transition-name: main-content"
    >
      <slot />
    </main>
    <Footer />

    <!-- Mobile-specific layout fixes -->
    <style>
      /* iOS Safari Safe Area Support */
      body {
        /* Support for iPhone X+ notch and home indicator */
        padding-top: env(safe-area-inset-top);
        padding-bottom: env(safe-area-inset-bottom);
        padding-left: env(safe-area-inset-left);
        padding-right: env(safe-area-inset-right);
      }

      /* MOBILE FIX: Adjust main content spacing for mobile */
      @media (max-width: 767px) {
        .mobile-main {
          padding-top: 4.25rem; /* 68px - matches mobile nav height */
          padding-bottom: 4rem; /* Reduced for compact footer */
          min-height: calc(100vh - 4.25rem);
          min-height: calc((var(--vh, 1vh) * 100) - 4.25rem);
        }
      }

      @media (max-width: 479px) {
        .mobile-main {
          padding-top: 4rem; /* 64px - slightly less for very small screens */
          padding-bottom: 3rem; /* Much smaller for compact footer */
          min-height: calc(100vh - 4rem);
          min-height: calc((var(--vh, 1vh) * 100) - 4rem);
        }
      }

      /* iOS Safari specific fixes */
      @supports (-webkit-touch-callout: none) {
        /* iOS Safari only styles */
        .mobile-main {
          /* Account for dynamic island and status bar */
          padding-top: calc(4.25rem + env(safe-area-inset-top));
          padding-bottom: calc(
            4rem + env(safe-area-inset-bottom)
          ); /* Reduced for compact footer */
          min-height: calc(
            100vh - env(safe-area-inset-top) - env(safe-area-inset-bottom)
          );
          min-height: calc(
            (var(--vh, 1vh) * 100) - env(safe-area-inset-top) -
              env(safe-area-inset-bottom)
          );
        }

        @media (max-width: 479px) {
          .mobile-main {
            padding-top: calc(4rem + env(safe-area-inset-top));
            padding-bottom: calc(
              3rem + env(safe-area-inset-bottom)
            ); /* Much smaller for compact footer */
          }
        }

        /* Prevent iOS Safari bounce scrolling issues but allow proper scrolling */
        body {
          position: relative;
          overflow-x: hidden;
          width: 100%;
          height: 100%;
        }

        .mobile-main {
          overflow-y: auto;
          -webkit-overflow-scrolling: touch;
        }
      }

      /* Ensure all content containers respect mobile boundaries */
      .content-wrapper,
      .container-fluid,
      .container-constrained {
        max-width: 100vw;
        /* Removed overflow-x: hidden to prevent drop shadow clipping */
        box-sizing: border-box;
        padding-left: 1rem;
        padding-right: 1rem;
      }

      /* Prevent any element from creating horizontal overflow */
      * {
        box-sizing: border-box;
      }

      img,
      video,
      canvas,
      svg {
        max-width: 100%;
        height: auto;
      }

      /* Text containment for mobile */
      p,
      h1,
      h2,
      h3,
      h4,
      h5,
      h6,
      span,
      div {
        word-wrap: break-word;
        overflow-wrap: break-word;
        hyphens: auto;
      }

      /* Responsive typography */
      .text-responsive {
        font-size: clamp(1rem, 2.5vw, 1.25rem);
        line-height: 1.4;
      }

      .heading-responsive {
        font-size: clamp(1.5rem, 5vw, 3rem);
        line-height: 0.9;
        letter-spacing: -0.025em;
      }

      .display-responsive {
        font-size: clamp(2rem, 8vw, 6rem);
        line-height: 0.8;
        letter-spacing: -0.05em;
      }

      /* iOS Safari haptic feedback support */
      @media (hover: none) and (pointer: coarse) {
        button,
        .button,
        a[role='button'],
        input[type='submit'],
        input[type='button'] {
          /* Enable haptic feedback on iOS */
          -webkit-tap-highlight-color: transparent;
          touch-action: manipulation;
        }
      }

      /* iOS Safari pull-to-refresh prevention */
      body {
        overscroll-behavior-y: none;
      }

      /* iOS Safari zoom prevention on form inputs */
      input[type='text'],
      input[type='email'],
      input[type='password'],
      input[type='search'],
      input[type='tel'],
      input[type='url'],
      select,
      textarea {
        font-size: 16px; /* Prevents zoom on iOS Safari */
      }
    </style>

    <!-- Theme switching functionality with iOS Safari theme color updates -->
    <script>
      // Theme toggle functionality
      function toggleTheme() {
        const html = document.documentElement;
        const currentTheme = html.getAttribute('data-theme') || 'light';
        const newTheme = currentTheme === 'light' ? 'dark' : 'light';

        html.setAttribute('data-theme', newTheme);
        localStorage.setItem('theme', newTheme);

        // Update iOS Safari theme color dynamically
        const newColor = '#b8869a'; // Use accent color for visibility
        const themeColorMeta = document.querySelector(
          'meta[name="theme-color"]'
        );
        if (themeColorMeta) {
          themeColorMeta.setAttribute('content', newColor);
        }

        // Dispatch custom event for components that need to react to theme changes
        window.dispatchEvent(
          new CustomEvent('themeChanged', { detail: { theme: newTheme } })
        );
      }

      // Make function globally available
      (window as any).toggleTheme = toggleTheme;

      // Apply saved theme on page load
      document.addEventListener('DOMContentLoaded', function () {
        const savedTheme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', savedTheme);

        // Update theme color on load
        const color = '#b8869a'; // Use accent color for visibility
        const themeColorMeta = document.querySelector(
          'meta[name="theme-color"]'
        );
        if (themeColorMeta) {
          themeColorMeta.setAttribute('content', color);
        }
      });

      // iOS Safari specific enhancements
      if ('serviceWorker' in navigator) {
        // Register service worker for PWA functionality
        navigator.serviceWorker
          .register('/sw.js')
          .then((registration) => {
            console.log(
              '✅ Service Worker registered successfully:',
              registration
            );

            // Check for updates on page focus
            document.addEventListener('visibilitychange', () => {
              if (!document.hidden) {
                registration.update();
              }
            });
          })
          .catch((error) => {
            console.error('❌ Service Worker registration failed:', error);
          });
      } else {
        console.log('⚠️ Service Workers not supported in this browser');
      }

      // iOS Safari viewport height fix
      function setViewportHeight() {
        const vh = window.innerHeight * 0.01;
        document.documentElement.style.setProperty('--vh', `${vh}px`);
      }

      setViewportHeight();
      window.addEventListener('resize', setViewportHeight);
      window.addEventListener('orientationchange', setViewportHeight);

      // Force Safari to hide address bar and enable minimal UI
      function enableSafariMinimalUI() {
        const isSafari =
          /Safari/.test(navigator.userAgent) &&
          !/Chrome/.test(navigator.userAgent);
        const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent);

        if (isSafari || isIOS) {
          // Force scroll to trigger minimal UI
          setTimeout(() => {
            window.scrollTo(0, 1);
            setTimeout(() => {
              window.scrollTo(0, 0);
              // Set proper viewport height after bars hide
              setViewportHeight();
            }, 100);
          }, 300);

          // Listen for scroll events to maintain minimal UI
          let ticking = false;
          const handleScroll = () => {
            if (!ticking) {
              requestAnimationFrame(() => {
                // Update theme color based on scroll position
                const scrolled = window.scrollY > 10;
                const themeColorMeta = document.querySelector(
                  'meta[name="theme-color"]'
                );
                if (themeColorMeta) {
                  const color = scrolled ? '#b8869a' : '#b8869a';
                  themeColorMeta.setAttribute('content', color);
                }
                ticking = false;
              });
              ticking = true;
            }
          };

          window.addEventListener('scroll', handleScroll, { passive: true });
        }
      }

      enableSafariMinimalUI();

      // iOS Safari scroll position restoration
      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }
    </script>

    <!-- View Transitions API initialization -->
    <script>
      // Import and initialize View Transitions
      import {
        setupAutoTransitions,
        isViewTransitionsSupported,
      } from '../lib/viewtransitions';

      // Initialize automatic transitions for internal links
      document.addEventListener('DOMContentLoaded', () => {
        if (isViewTransitionsSupported()) {
          console.log(
            'View Transitions API supported - enabling smooth transitions'
          );
        } else {
          console.log(
            'View Transitions API not supported - using fallback transitions'
          );
        }

        // Setup automatic transitions for all internal links
        setupAutoTransitions(
          'a[href^="/"], a[href*="' + window.location.origin + '"]'
        );
      });

      // Re-initialize on Astro page loads (for SPA-like behavior)
      document.addEventListener('astro:page-load', () => {
        setupAutoTransitions(
          'a[href^="/"], a[href*="' + window.location.origin + '"]'
        );
      });
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/variables.scss';
  @import '../styles/global.css';
  @import '../styles/utilities.scss';

  /* iOS Safari custom properties for viewport */
  :root {
    --vh: 1vh;
  }

  /* Use custom viewport height for iOS Safari */
  .min-h-screen {
    min-height: 100vh;
    min-height: calc(var(--vh, 1vh) * 100);
  }

  /* Safari minimal UI - hide bars on scroll */
  .safari-minimal-ui {
    /* Enable momentum scrolling on iOS */
    -webkit-overflow-scrolling: touch;

    /* Force Safari to hide address bar on scroll */
    overflow-x: hidden;

    /* Ensure full height to trigger Safari minimal UI */
    min-height: 100vh;
    min-height: 100svh; /* Small viewport height for Safari */
  }

  /* iOS Safari specific optimizations */
  @supports (-webkit-touch-callout: none) {
    .safari-minimal-ui {
      /* Trigger minimal UI mode */
      min-height: 100vh;
      min-height: -webkit-fill-available;

      /* Force Safari to hide UI chrome */
      height: 100vh;
      height: -webkit-fill-available;
    }

    /* Ensure content fills the space when bars hide */
    body {
      min-height: 100vh;
      min-height: -webkit-fill-available;
    }
  }

  /* Modern Safari viewport units */
  @supports (height: 100svh) {
    .safari-minimal-ui {
      min-height: 100svh;
    }
  }
</style>
